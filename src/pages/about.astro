---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { getPage } from '../lib/content';

const about = await getPage('about');
const director = await getPage('director');
---

<Base
  title="About"
  description="The Alpharetta High School Orchestra program — founded in 2004, six ensembles, and a history that includes Carnegie Hall and the Midwest Clinic."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>{about.title}</h1>
      <Prose><Fragment set:html={about.html} /></Prose>
    </div>
  </section>

  <section class="section section--alt" id="director">
    <div class="wrap">
      <p class="eyebrow">Leadership</p>
      <h2>{director.title}</h2>
      <Prose><Fragment set:html={director.html} /></Prose>
    </div>
  </section>
</Base>
