---
import Portal from '../../layouts/Portal.astro';
---

<Portal title="Photos" roles={['admin', 'webmaster']}>
  <div class="head">
    <div>
      <h1>Photos</h1>
      <p class="sub">The spinning ring of photos on the homepage. Ten to twelve photos looks best.</p>
    </div>
    <label class="pbtn pbtn--primary" for="file">Add photos</label>
    <input id="file" type="file" accept="image/*" multiple class="vh" />
  </div>

  <section class="card">
    <h2>In the ring <span class="count" id="count"></span></h2>
    <p class="hint" style="margin:-.4rem 0 1rem">
      Only post photos the program is cleared to publish. Students appear in most of them.
      Photos are cropped to a 4:5 portrait from the centre and resized before upload.
    </p>
    <p class="empty" id="status" role="status"></p>
    <ul class="grid" id="grid"></ul>
  </section>
</Portal>

<style>
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .count { font-weight: 400; color: var(--ink-soft); font-size: .9rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem; }
  .grid li { display: grid; gap: .4rem; }
  .grid img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 6px; background: #EEF0F2; }
  .tools { display: flex; gap: .3rem; }
  .tools button {
    flex: 1; font: inherit; font-size: .78rem; padding: .3rem; cursor: pointer;
    border: 1px solid #D8DDE0; background: #fff; border-radius: 5px; color: var(--ink);
  }
  .tools button:hover:not([disabled]) { border-color: var(--ink-soft); }
  .tools button[disabled] { opacity: .4; cursor: default; }
  .tools .rm { color: #8A2B29; }
  label.pbtn { cursor: pointer; }
  #file:focus-visible + * , label.pbtn:focus-within { outline: 2px solid var(--maroon); }
</style>

<script>
  import { whenReady, toast, explain } from '../../portal/client';
  import { ringPhotoUrl } from '../../lib/supabase';

  const { db } = await whenReady();
  const grid = document.getElementById('grid')!;
  const status = document.getElementById('status')!;
  const input = document.getElementById('file') as HTMLInputElement;

  let rows: { id: string; path: string; sort: number }[] = [];

  async function load() {
    const { data, error } = await db.from('ring_photos').select('*').order('sort');
    if (error) return toast(explain(error), 'error');
    rows = data;
    render();
  }

  function render() {
    document.getElementById('count')!.textContent = `(${rows.length})`;
    status.textContent = rows.length ? '' : 'No photos uploaded yet. Until there are, the ring shows the five photos built into the site.';
    grid.innerHTML = rows.map((r, i) => `<li>
      <img src="${ringPhotoUrl(r.path)}" alt="" loading="lazy" />
      <div class="tools">
        <button type="button" data-act="up" data-i="${i}" ${i === 0 ? 'disabled' : ''} aria-label="Move earlier">Earlier</button>
        <button type="button" data-act="down" data-i="${i}" ${i === rows.length - 1 ? 'disabled' : ''} aria-label="Move later">Later</button>
        <button type="button" class="rm" data-act="rm" data-i="${i}">Remove</button>
      </div></li>`).join('');
  }

  /** Centre-crop to 4:5 and shrink to 900x1125 WebP. Keeps uploads ~150 KB. */
  async function prepare(file: File): Promise<Blob> {
    const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' } as any);
    const W = 900, H = 1125, target = W / H;
    let sw = bmp.width, sh = bmp.height, sx = 0, sy = 0;
    if (sw / sh > target) { sw = Math.round(sh * target); sx = Math.round((bmp.width - sw) / 2); }
    else { sh = Math.round(sw / target); sy = Math.round((bmp.height - sh) / 2); }
    const c = document.createElement('canvas');
    c.width = W; c.height = H;
    c.getContext('2d')!.drawImage(bmp, sx, sy, sw, sh, 0, 0, W, H);
    return new Promise((res, rej) => c.toBlob((b) => (b ? res(b) : rej(new Error('encode'))), 'image/webp', 0.82));
  }

  input.addEventListener('change', async () => {
    const files = [...(input.files ?? [])];
    input.value = '';
    if (!files.length) return;
    let next = rows.length ? Math.max(...rows.map((r) => r.sort)) + 1 : 1;
    let done = 0;
    for (const file of files) {
      status.textContent = `Uploading ${done + 1} of ${files.length}…`;
      try {
        const blob = await prepare(file);
        const path = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.webp`;
        const up = await db.storage.from('ring').upload(path, blob, { contentType: 'image/webp' });
        if (up.error) throw up.error;
        const { error } = await db.from('ring_photos').insert({ path, sort: next++ });
        if (error) throw error;
        done++;
      } catch (err: any) {
        toast(`${file.name}: ${err?.message === 'encode' ? 'couldn’t read this image' : explain(err)}`, 'error');
      }
    }
    toast(done ? `Added ${done} photo${done > 1 ? 's' : ''}. The homepage updates after the next site update.` : 'Nothing was uploaded.', done ? 'ok' : 'error');
    load();
  });

  grid.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const i = Number(b.dataset.i);
    const r = rows[i];
    if (b.dataset.act === 'rm') {
      if (!confirm('Remove this photo from the ring?')) return;
      const { error } = await db.from('ring_photos').delete().eq('id', r.id);
      if (error) return toast(explain(error), 'error');
      await db.storage.from('ring').remove([r.path]);
      toast('Removed.');
      return load();
    }
    const j = b.dataset.act === 'up' ? i - 1 : i + 1;
    const other = rows[j];
    // Swap positions. Two small updates; the list reloads either way.
    const a1 = await db.from('ring_photos').update({ sort: other.sort }).eq('id', r.id);
    const a2 = await db.from('ring_photos').update({ sort: r.sort }).eq('id', other.id);
    if (a1.error || a2.error) toast(explain(a1.error ?? a2.error), 'error');
    load();
  });

  load();
</script>
