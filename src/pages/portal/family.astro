---
import Portal from '../../layouts/Portal.astro';

const charges = [
  { label: 'Student Participation Fee 2026–27', due: 'Sep 15, 2026', amount: '$195.00', status: 'due' },
  { label: 'Concert Uniform — dress, size 8', due: 'Sep 15, 2026', amount: '$0.00', status: 'paid' },
  { label: 'Patron Program (optional)', due: '—', amount: '$0.00', status: 'paid' },
];

const forms = [
  { label: 'Medical / emergency contact', status: 'Complete' },
  { label: 'Photo release', status: 'Complete' },
  { label: 'Spring trip permission', status: 'Not started' },
];
---

<Portal title="Overview" role="family">
  <h1>Anh Nguyen</h1>
  <p class="sub">Symphony Orchestra &middot; 4th period &middot; Class of 2028</p>

  <!-- Balance ------------------------------------------------------->
  <section class="card" id="fees">
    <h2>Fees</h2>
    <div style="overflow-x:auto">
      <table class="tbl">
        <thead>
          <tr><th>Item</th><th>Due</th><th class="num">Amount</th><th>Status</th></tr>
        </thead>
        <tbody>
          {charges.map((c) => (
            <tr>
              <td>{c.label}</td>
              <td>{c.due}</td>
              <td class="num">{c.amount}</td>
              <td>
                <span class:list={['pill', c.status === 'paid' ? 'pill--paid' : 'pill--due']}>
                  {c.status === 'paid' ? 'Paid' : 'Due'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="total">
      <span>Balance due</span>
      <b>$195.00</b>
    </div>
  </section>

  <!-- Stripe placeholder -------------------------------------------->
  <section class="card">
    <h2>Payment</h2>
    <div class="stripe-slot">
      <p class="stripe-slot__label">Stripe will go here</p>
      <p class="stripe-slot__note">
        Card entry and checkout, handled by Stripe. Card numbers never touch
        this site or our database — Stripe takes them directly.
      </p>
    </div>
    <p class="gate">
      <b>Not built yet.</b> This needs a Stripe account owned by the Orchestra
      Association — its EIN, its bank account, the treasurer as account owner.
      Stripe requires account owners to be 18+, so it cannot be in a
      student&rsquo;s name.
    </p>
  </section>

  <!-- Forms --------------------------------------------------------->
  <section class="card" id="forms">
    <h2>Forms</h2>
    <table class="tbl">
      <thead><tr><th>Form</th><th>Status</th></tr></thead>
      <tbody>
        {forms.map((f) => (
          <tr>
            <td>{f.label}</td>
            <td>
              <span class:list={['pill', f.status === 'Complete' ? 'pill--paid' : 'pill--due']}>
                {f.status}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Privacy</h2>
    <div class="locked">
      <span aria-hidden="true" style="font-size:1.1rem;line-height:1">🔒</span>
      <span>
        <b style="display:block;color:var(--ink);margin-bottom:.25rem">
          You only ever see your own student
        </b>
        Other families&rsquo; records aren&rsquo;t hidden from view — the database
        won&rsquo;t return them for this account at all.
      </span>
    </div>
  </section>
</Portal>

<style is:global>
  .total {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-top: 1.1rem; padding-top: 1rem; border-top: 2px solid var(--ink);
  }
  .total span { font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
  .total b { font-size: 1.45rem; font-variant-numeric: tabular-nums; }

  .stripe-slot {
    display: grid; place-items: center; gap: .5rem; text-align: center;
    min-height: 190px; padding: 2rem 1.25rem;
    border: 2px dashed #C9CFD3; border-radius: 8px;
    background: repeating-linear-gradient(-45deg, #F4F5F6 0 10px, transparent 10px 20px);
  }
  .stripe-slot__label {
    margin: 0; font-size: 1.15rem; font-weight: 600;
    letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft);
  }
  .stripe-slot__note { margin: 0; max-width: 44ch; font-size: .86rem; color: var(--ink-faint); }

  .gate {
    margin: 1rem 0 0; font-size: .85rem; color: var(--ink-soft);
    background: #FBF7F7; border: 1px solid #E4D2D1; border-radius: 7px; padding: .85rem 1rem;
  }
  .gate b { color: var(--maroon); }
</style>
