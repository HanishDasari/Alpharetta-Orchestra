---
/* A ring of photos that turns slowly and never stops, seen from just
   above. Pure CSS: the ring is one element rotating on its Y axis, and
   each photo is placed around it with rotateY + translateZ.

   Photos face outward with their backs hidden, so only the front half
   of the ring is ever visible. That's what lets a short list repeat to
   fill the ring: copies sit opposite each other and never show at once.

   Hovering pauses it (mouse only). The Pause button covers keyboard and
   touch, and WCAG 2.2.2 asks for one on anything that moves on its own
   for more than five seconds. Reduced motion shows a still ring. */

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  /** Local imports get resized at build; URLs (portal uploads, already
      resized in the browser before upload) are used as they are. */
  photos: (ImageMetadata | string)[];
  /** Seconds for one full turn */
  speed?: number;
  label?: string;
}

const { photos, speed = 60, label = 'Orchestra photos' } = Astro.props;

// Cards are at most 260px wide, so 600px covers 2x screens. Cropped to
// the card's 4:5 shape here so phones don't download the unused sides.
const sized = await Promise.all(
  photos.map((src) => typeof src === 'string'
    ? { src }
    : getImage({ src, width: 600, height: 750, fit: 'cover', format: 'webp' })),
);

// Fewer than ~10 faces makes the ring read as a polygon, so short lists
// repeat. With an even count the copies land opposite each other.
const MIN_SLOTS = 10;
const count = sized.length < MIN_SLOTS
  ? Math.ceil(MIN_SLOTS / sized.length) * sized.length
  : sized.length;
const slots = Array.from({ length: count }, (_, i) => sized[i % sized.length]);
---

<div class="ring" style={`--n:${count}; --speed:${speed}s`} data-ring>
  <div class="ring__stage" role="img" aria-label={label}>
    <ul class="ring__track" aria-hidden="true">
      {slots.map((p, i) => (
        <li class="ring__face" style={`--i:${i}`}>
          <img src={p.src} alt="" width="600" height="750" loading="lazy" decoding="async" draggable="false" />
        </li>
      ))}
    </ul>
  </div>

  <button type="button" class="ring__toggle" aria-pressed="false" data-ring-toggle>
    Pause
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ring]').forEach((ring) => {
    const btn = ring.querySelector<HTMLButtonElement>('[data-ring-toggle]');
    btn?.addEventListener('click', () => {
      const paused = ring.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Play' : 'Pause';
    });
  });
</script>

<style>
  .ring {
    /* Card width drives everything else; the radius is whatever fits
       --n cards around the circle with a little air between them. */
    --w: clamp(150px, 19vw, 260px);
    --r: calc(var(--w) * 0.56 / tan(180deg / var(--n)));
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2rem;
  }

  .ring__stage {
    width: 100%;
    /* The front card sits closer than the track plane, so perspective
       draws it ~4/3 larger (perspective is 4r), and the downward tilt
       pushes its bottom edge lower still. The extra goes below. */
    height: calc(var(--w) * 1.25 * 4 / 3 + 1rem);
    padding-bottom: calc(var(--w) * 0.45);
    box-sizing: content-box;
    display: grid;
    place-items: center;
    perspective: calc(var(--r) * 4);
    perspective-origin: 50% 30%;
    /* The ring is wider than small screens; let it run off the edges
       instead of adding a horizontal scrollbar. */
    overflow-x: clip;
    overflow-y: visible;
  }

  .ring__track {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    width: var(--w);
    aspect-ratio: 4 / 5;
    transform-style: preserve-3d;
    /* Constant motion, so linear. The tilt is baked into the keyframes
       so it stays put while the ring turns. */
    animation: ring-turn var(--speed) linear infinite;
  }

  .ring__face {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(360deg / var(--n) * var(--i))) translateZ(var(--r));
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper-off);
    box-shadow: 0 18px 40px -18px rgb(98 27 29 / 0.45);
  }

  .ring__face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  @keyframes ring-turn {
    from { transform: rotateX(-7deg) rotateY(0deg); }
    to   { transform: rotateX(-7deg) rotateY(-360deg); }
  }

  .ring.is-paused .ring__track { animation-play-state: paused; }

  @media (hover: hover) and (pointer: fine) {
    .ring__stage:hover .ring__track { animation-play-state: paused; }
  }

  .ring__toggle {
    font: 500 13px/1 var(--font-body);
    letter-spacing: .04em;
    color: var(--maroon);
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: .55rem 1.15rem;
    cursor: pointer;
    transition: background-color .18s var(--ease), color .18s var(--ease), transform .16s var(--ease);
  }
  .ring__toggle:hover { background: var(--maroon); color: #fff; }
  .ring__toggle:active { transform: scale(0.97); }

  @media (max-width: 700px) {
    .ring { --w: clamp(120px, 34vw, 180px); }
  }

  /* The global reduced-motion rule shortens animations to .01ms, which
     on an infinite loop would flicker. Stop it outright instead. */
  @media (prefers-reduced-motion: reduce) {
    .ring__track {
      animation: none !important;
      transform: rotateX(-7deg);
    }
    .ring__toggle { display: none; }
  }
</style>
