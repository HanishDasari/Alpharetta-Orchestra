---
import Portal from '../../layouts/Portal.astro';
import { store, contact } from '../../lib/links';
---

<Portal title="Overview" roles={['family', 'admin']}>
  <p class="viewas" id="viewas" hidden>You&rsquo;re viewing this as a family. Real families see their own students here, and their fees, which the director&rsquo;s account can&rsquo;t.</p>

  <h1 id="hello">Overview</h1>
  <p class="sub">Your student, forms to fill, and fees.</p>

  <section class="card" aria-labelledby="kids-h">
    <h2 id="kids-h">Your student</h2>
    <div class="kids" id="kids"><p class="empty">Loading&hellip;</p></div>
  </section>

  <section class="card" id="forms" aria-labelledby="forms-h">
    <h2 id="forms-h">Forms to fill</h2>
    <ul class="list" id="formlist"><li><p class="empty">Loading&hellip;</p></li></ul>
  </section>

  <section class="card" id="fees" aria-labelledby="fees-h">
    <h2 id="fees-h">Fees</h2>
    <p>Dues, the patron program and program book ads are paid through the Orchestra Association store for now.</p>
    <div class="actions" style="margin:0 0 1.25rem">
      <a class="pbtn pbtn--primary" href={store.dues}>Pay dues in the store</a>
      <a class="pbtn pbtn--ghost" href={`mailto:${contact.treasurer.email}`}>Email the treasurer</a>
    </div>
    <div class="demo">
      <p class="demo__tag">Coming later: sample only, not your account</p>
      <table class="tbl">
        <thead><tr><th>Item</th><th class="num">Amount</th><th>Status</th></tr></thead>
        <tbody>
          <tr><td>Participation fee 2026&ndash;27</td><td class="num">$195.00</td><td><span class="pill pill--due">Due Sep 15</span></td></tr>
          <tr><td>Winter concert field trip</td><td class="num">$25.00</td><td><span class="pill pill--paid">Paid</span></td></tr>
        </tbody>
      </table>
      <p class="hint">Once the booster board signs off, balances and online payment will show here, and only to your family.</p>
    </div>
  </section>

  <section class="card" aria-labelledby="news-h">
    <h2 id="news-h">Announcements</h2>
    <div id="news"></div>
  </section>
</Portal>

<style>
  .viewas { background: #FFF6E5; color: #6B4A00; border-radius: 8px; padding: .6rem .9rem; font-size: .88rem; margin: 0 0 1rem; }
  .kids { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .75rem; }
  .kid { border: 1px solid #E3E6E8; border-radius: 8px; padding: .9rem 1rem; }
  .kid b { display: block; font-size: 1rem; }
  .kid small { color: var(--ink-soft); }
  .demo { border: 1px dashed #CFD5D9; border-radius: 8px; padding: 1rem; background: #FAFBFB; }
  .demo__tag { margin: 0 0 .6rem; font-size: .78rem; font-weight: 600; color: #6B4A00; }
  .demo .tbl { opacity: .75; }
  .md p { margin: 0 0 .6rem; }
  .news + .news { border-top: 1px solid #EDEFF1; padding-top: 1rem; margin-top: 1rem; }
  .news small { color: var(--ink-soft); }
</style>

<script>
  import { renderMarkdown } from '../../lib/markdown';
  import { whenReady, esc, toast, explain, fmtDay, schoolToday } from '../../portal/client';
  import { contact } from '../../lib/links';

  const { db, profile } = await whenReady();
  const asAdmin = profile.role === 'admin';
  const today = schoolToday();
  const byId = (x: string) => document.getElementById(x)!;
  byId('viewas').hidden = !asAdmin;
  if (!asAdmin && profile.full_name) byId('hello').textContent = `Hi, ${profile.full_name.split(' ')[0]}`;

  const [kids, forms, mine, news] = await Promise.all([
    // RLS returns only students linked to this account (for admin: everyone, so skip).
    asAdmin ? Promise.resolve({ data: [], error: null }) : db.from('students').select('*').order('first_name'),
    db.from('forms').select('*').in('audience', ['family', 'both']).order('created_at', { ascending: false }),
    db.from('form_responses').select('form_id').eq('profile_id', profile.id),
    db.from('news').select('*').eq('draft', false).order('date', { ascending: false }).limit(3),
  ]);
  const err = kids.error ?? forms.error ?? mine.error ?? news.error;
  if (err) toast(explain(err), 'error');

  byId('kids').innerHTML = (kids.data ?? []).length
    ? kids.data!.map((s: any) => `<div class="kid"><b>${esc(s.first_name)} ${esc(s.last_name)}</b>
        <small>${[s.ensemble, s.period && `${s.period} period`, s.grad_year && `Class of ${s.grad_year}`].filter(Boolean).map(esc).join(' · ') || 'Not placed yet'}</small></div>`).join('')
    : `<p class="empty">${asAdmin ? 'Families see their own students here.' : `No student is linked to this account yet. Email <a href="mailto:${contact.director.email}">Mr. Hood</a> to have it set up.`}</p>`;

  const done = new Set((mine.data ?? []).map((r) => r.form_id));
  const open = (forms.data ?? []).filter((x) => x.open && (!x.closes_on || x.closes_on >= today));
  byId('formlist').innerHTML = open.length
    ? open.map((x) => `<li><a class="row" href="/portal/form?id=${x.id}"><b>${esc(x.title)}</b>
        <small>${x.closes_on ? `Due ${fmtDay(x.closes_on, { month: 'short', day: 'numeric' })}` : 'No deadline'}</small>
        ${done.has(x.id) ? '<span class="pill pill--paid">Done</span>' : '<span class="pill pill--due">To do</span>'}</a></li>`).join('')
    : '<li><p class="empty">Nothing to fill in right now.</p></li>';

  byId('news').innerHTML = (news.data ?? []).length
    ? news.data!.map((n) => `<article class="news"><b>${esc(n.title)}</b> <small>${fmtDay(n.date, { month: 'short', day: 'numeric' })}</small>
        <div class="md">${renderMarkdown(n.body)}</div></article>`).join('')
    : '<p class="empty">No announcements.</p>';
</script>
