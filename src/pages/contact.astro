---
import Base from '../layouts/Base.astro';
import { contact, social } from '../lib/links';

const { director, treasurer, school } = contact;
---

<Base
  title="Contact"
  description="Contact the Alpharetta High School Orchestras: the director, the booster treasurer, and the school."
>
  <section class="section">
    <div class="wrap">
      <h1>Contact</h1>
      <p class="lede">
        Email is the fastest way to reach us. Pick whoever fits your question.
      </p>

      <div class="who">
        <div>
          <h2>{director.name}</h2>
          <p class="role">{director.title}</p>
          <p>Lessons, auditions, concerts, joining the program, and anything else.</p>
          <a class="mail" href={`mailto:${director.email}`}>{director.email}</a>
        </div>

        <div>
          <h2>Booster Treasurer</h2>
          <p class="role">Orchestra Association</p>
          <p>Dues, payment plans, the patron program, and program book ads.</p>
          <a class="mail" href={`mailto:${treasurer.email}`}>{treasurer.email}</a>
        </div>

        <div>
          <h2>{school.name}</h2>
          <p class="role">Front office</p>
          <p>{school.street}<br />{school.city}</p>
          <a class="mail" href={school.phoneHref}>{school.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2 class="follow">Follow along</h2>
      <p class="links">
        <a href={social.instagram} rel="noopener">Instagram</a>
        <a href={social.youtube} rel="noopener">YouTube</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .who {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2.5rem 3rem;
    margin-top: 3rem;
  }
  .who h2 { font-size: var(--step-2); line-height: 1.2; margin-bottom: .2rem; }
  .role { color: var(--maroon); font-weight: 500; margin-bottom: .9rem; }
  .who p:not(.role) { color: var(--ink-soft); }
  .mail { font-weight: 500; overflow-wrap: anywhere; }

  .follow { font-size: var(--step-2); line-height: 1.2; }
  .links { display: flex; gap: 1.75rem; font-weight: 500; }
</style>
