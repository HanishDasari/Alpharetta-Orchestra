---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { getPage } from '../lib/content';
import { contact, docs } from '../lib/links';

const instruments = await getPage('instruments');

// href: null renders the card as plain text until there's something to link to.
const resources = [
  {
    title: 'Student Handbook',
    body: 'Grading, attendance, concert expectations, and program policies.',
    href: docs.handbook,
  },
  {
    title: 'Audition Materials',
    body: 'Scales and excerpts for placement auditions. Posted here each spring.',
    href: null,
  },
  {
    title: 'Concert Uniforms',
    body: 'Approved dresses and tuxedos, and what else counts as concert black.',
    href: '#uniforms',
  },
  {
    title: 'Instrument Dealers & Repair',
    body: 'Local shops for rentals, purchases, and repairs.',
    href: '#dealers',
  },
];

const uniforms = [
  {
    title: 'Dresses',
    body: 'Choose the Everett, Kingsley, or Noel. Dresses arrive un-hemmed; many dry cleaners offer hemming.',
    links: [
      { label: 'Everett', href: 'https://sepapparel.com/everett-concert-choir-dress.html' },
      { label: 'Kingsley', href: 'https://sepapparel.com/kingsley-concert-choir-dress.html' },
      { label: 'Noel', href: 'https://sepapparel.com/noel-dress-ladies-concert-choir.html' },
    ],
  },
  {
    title: 'Tuxedos',
    body: 'We wear a black shirt under the jacket instead of white, with a bowtie or long tie. Any collar style is fine, and any vendor is fine.',
    links: [{ label: 'Full tuxedo with long tie', href: 'https://sepapparel.com/full-tuxedo-with-long-tie.html' }],
  },
  {
    title: 'Alternative clothing',
    body: 'If tuxes and dresses aren’t your style, anything formal and all black works. Formal black closed-toe shoes are part of every uniform.',
    links: [{ label: 'Coregami catalog', href: 'https://coregami.com/' }],
  },
];

const dealers = [
  { name: 'Atlanta Violins', address: '387 S Atlanta St., Roswell', phone: '(770) 642-8111', url: 'https://www.atlantaviolins.com' },
  { name: 'Beau Vinci Violins', address: '116 N Main St., Alpharetta', phone: '(678) 691-2394', url: 'https://www.beauvinciviolins.com' },
  { name: 'Draisen Edwards Music', address: '4880 Lower Roswell Rd, Suite 780E, Marietta', phone: '(770) 971-9755', url: 'https://www.draisenedwardsmusic.com' },
  { name: 'Harmony House', address: '3610 Kennesaw N. Industrial Pkwy, Suite 100A, Kennesaw', phone: '(770) 422-0022', url: 'http://www.theharmonyhouse.net' },
  { name: 'Huthmaker Violins', address: '3949 Russell St., Suwanee', phone: '(770) 945-1188', url: 'https://www.huthmakerviolins.com' },
  { name: 'Jennings Music', address: '2511 Canton Rd., Marietta', phone: '(770) 425-2560', url: 'https://www.jenningsmusic.com' },
  { name: 'Ken Stanton Music (North Point)', address: '6010 North Point Pkwy, Alpharetta', phone: '(770) 670-4424', url: 'http://www.kenstanton.net' },
  { name: 'Mandarin Strings', address: '1735 Roswell Rd., Marietta', phone: '(404) 936-5653', url: 'http://www.mandarinstrings.com' },
  { name: 'Music & Arts (North Point)', address: '7331 North Point Pkwy, Alpharetta', phone: '(770) 993-4428', url: 'http://www.musicarts.com' },
  { name: 'Ronald Sachs Violins (Lilburn)', address: '836 Pleasant Hill Rd, Lilburn', phone: '(770) 485-8814', url: 'http://www.ronaldsachs.com' },
  { name: 'Ronald Sachs Violins (Marietta)', address: '3100 Roswell Rd, Ste. 117, Marietta', phone: '(770) 931-2440', url: 'http://www.ronaldsachs.com' },
  { name: 'Voss Violins', address: '620 Glen Iris Dr NE, Springs Loft 104, Atlanta', phone: '(404) 876-8617', url: 'http://www.vossviolins.com' },
];

const summer = [
  {
    name: 'Summer Arts Intensive, Kennesaw State University',
    detail: 'Taught by faculty from the Atlanta Symphony Orchestra.',
    url: 'https://www.kennesaw.edu/arts/academics/music/community-programs/summer-arts-intensive.php',
  },
  {
    name: 'UGA Summer Music Camp',
    detail: 'Five-day residential camp with masterclasses. Rising 9th graders and up, placement audition required.',
    url: 'https://ugamusiccamps.weebly.com/music-camp.html',
  },
  {
    name: 'Atlanta Chamber Music Festival, Emory University',
    detail: 'Seven-day residential chamber music program, grades 6–12. Applications due May 1.',
    url: 'http://www.atlantachambermusicfestival.com/',
  },
  {
    name: 'FSU String Orchestra Camp',
    detail: 'Week-long intensive with sectionals, masterclasses, chamber ensembles, and theory.',
    url: 'https://music.fsu.edu/summermusiccamps/String-Orchestra-Camp',
  },
  { name: 'Vivo Summer String Institute, Atlanta Symphony Orchestra', detail: null, url: 'https://www.aso.org/education-community/educators/vivo-summer-string-institute' },
  { name: 'GSU Summer Music Institute', detail: null, url: 'https://thearts.gsu.edu/educational-outreach-summermusic/' },
  { name: 'Atlanta Festival Academy Summer Music Institute', detail: null, url: 'https://atlantafestivalacademy.org/smi/' },
  { name: 'Franklin Pond Summer Intensive', detail: null, url: 'https://franklinpond.org/summer-intensive-program/' },
  { name: 'MYSO Summer Workshop', detail: null, url: 'https://www.mysoatlanta.org/' },
  { name: 'Upbeat String Camp', detail: null, url: 'https://www.upbeatstringcamp.com/' },
];
---

<Base
  title="Student Resources"
  description="Handbook, audition materials, uniforms, instrument guidance, and summer programs for Alpharetta High School orchestra students."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">For students &amp; families</p>
      <h1>Resources</h1>
      <p class="lede">
        Everything you need for the year, in one place.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cards">
        {resources.map((r) => r.href ? (
          <a href={r.href} class="card">
            <h2>{r.title}</h2>
            <p>{r.body}</p>
          </a>
        ) : (
          <div class="card card--soon">
            <h2>{r.title}</h2>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="uniforms" style="padding-top:0">
    <div class="wrap">
      <h2>Concert uniforms</h2>
      <div class="uni">
        {uniforms.map((u) => (
          <div>
            <h3>{u.title}</h3>
            <p>{u.body}</p>
            <p class="uni__links">
              {u.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Instruments</p>
      <h2>{instruments.title}</h2>
      <Prose><Fragment set:html={instruments.html} /></Prose>

      <h3 id="dealers" class="dealers__title">Instrument dealers &amp; repair shops</h3>
      <ul class="dealers">
        {dealers.map((d) => (
          <li>
            <a href={d.url} rel="noopener"><strong>{d.name}</strong></a>
            <span>{d.address}</span>
            <a href={`tel:${d.phone.replace(/[^0-9]/g, '')}`}>{d.phone}</a>
          </li>
        ))}
      </ul>
      <p class="note">
        Mr. Hood and the AHS Orchestra program don&rsquo;t endorse any particular
        vendor. To have a shop added, <a href={`mailto:${contact.director.email}`}>email Mr. Hood</a>.
      </p>
    </div>
  </section>

  <section class="section" id="summer">
    <div class="wrap">
      <p class="eyebrow">Going further</p>
      <h2>Summer programs</h2>
      <p class="lede" style="margin-bottom:2.5rem">
        Students who want to keep playing over the summer have good options
        close to home.
      </p>
      <ul class="list">
        {summer.map((s) => (
          <li>
            <a href={s.url} rel="noopener"><strong>{s.name}</strong></a>
            {s.detail && <span>{s.detail}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
  .card {
    display: block; padding: 1.6rem 1.4rem;
    border: 1px solid var(--rule); border-radius: var(--radius);
    text-decoration: none; color: var(--ink);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .card h2 { font-size: var(--step-0); font-weight: 600; margin-bottom: 0.4rem; }
  .card p { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }

  .card--soon { border-style: dashed; }
  .card--soon:hover { transform: none; box-shadow: none; }

  .uni { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem 3rem; margin-top: 1.5rem; }
  .uni h3 { font-size: var(--step-1); line-height: 1.3; margin-bottom: .4rem; }
  .uni p { font-size: .95rem; color: var(--ink-soft); margin-bottom: .6rem; }
  .uni__links { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; font-weight: 500; }

  .dealers__title { font-size: var(--step-2); line-height: 1.2; margin-top: 3.5rem; }
  .dealers {
    list-style: none; padding: 0; margin: 1.5rem 0 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.75rem 2rem;
  }
  .dealers li { display: grid; gap: .1rem; font-size: .925rem; line-height: 1.5; }
  .dealers span { color: var(--ink-soft); }
  .note { font-size: .875rem; color: var(--ink-soft); margin-top: 2rem; max-width: var(--measure); }

  .list a { color: var(--ink); text-decoration-color: var(--rule); }
  .list a:hover { color: var(--maroon); }

  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .list li {
    display: grid; gap: 0.3rem;
    padding-bottom: 1.25rem; border-bottom: 1px solid var(--rule);
  }
  .list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .list strong { font-weight: 600; }
  .list span { font-size: 0.925rem; color: var(--ink-soft); }
</style>
