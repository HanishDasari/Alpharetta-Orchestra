---
import Portal from '../../layouts/Portal.astro';
import { BLOCK_TYPES } from '../../lib/blocks';
---

<Portal title="Pages" roles={['admin', 'webmaster']}>
  <div class="head">
    <div>
      <h1>Pages</h1>
      <p class="sub">Every page on the website is a stack of sections. Add, edit, reorder or remove them; the layout keeps itself tidy on phones.</p>
    </div>
    <button class="pbtn pbtn--primary" type="button" id="new">New page</button>
  </div>

  <div class="split split--pages">
    <section class="card" aria-labelledby="list-h">
      <h2 id="list-h">Pages</h2>
      <ul class="list" id="list"><li><p class="empty">Loading&hellip;</p></li></ul>
    </section>

    <div id="editor" hidden>
      <section class="card" aria-labelledby="set-h">
        <h2 id="set-h">Page settings</h2>
        <div class="row2">
          <div class="fld">
            <label for="p-title">Page title</label>
            <input class="inp" id="p-title" maxlength="80" />
            <p class="hint">Shown in the browser tab and search results.</p>
          </div>
          <div class="fld">
            <label for="p-slug">Web address</label>
            <input class="inp" id="p-slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" />
            <p class="hint" id="p-slug-hint"></p>
          </div>
        </div>
        <div class="fld">
          <label for="p-desc">Search engine description <span class="opt">(optional)</span></label>
          <input class="inp" id="p-desc" maxlength="200" />
        </div>
        <label class="check fld" id="p-draft-wrap"><input type="checkbox" id="p-draft" /> Hidden from the website (draft)</label>
        <div class="actions">
          <a class="pbtn pbtn--ghost" id="view" target="_blank" rel="noopener">View on site</a>
          <span class="spacer"></span>
          <button class="pbtn pbtn--danger" type="button" id="del">Delete page</button>
        </div>
      </section>

      <h2 class="secs-h">Sections</h2>
      <ol class="secs" id="secs"></ol>
      <button class="pbtn pbtn--ghost add-sec" type="button" data-act="add" data-at="end">Add a section</button>

      <div class="savebar" id="savebar">
        <span id="dirty">All changes saved.</span>
        <span class="spacer"></span>
        <button class="pbtn pbtn--ghost" type="button" id="revert">Undo changes</button>
        <button class="pbtn pbtn--primary" type="button" id="save">Save page</button>
      </div>
    </div>
  </div>

  <dialog class="picker" id="types">
    <form method="dialog" class="picker__head"><h2>Add a section</h2><button class="pbtn pbtn--ghost" value="cancel">Cancel</button></form>
    <div class="types">
      {BLOCK_TYPES.map((t) => (
        <button type="button" data-type={t.type}><b>{t.name}</b><small>{t.hint}</small></button>
      ))}
    </div>
  </dialog>

  <datalist id="site-links"></datalist>
</Portal>

<style is:global>
  .split--pages { grid-template-columns: minmax(0, 260px) minmax(0, 1fr); }
  .opt { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .secs-h { font-size: 1.05rem; margin: 1.75rem 0 .75rem; }
  .secs { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: .75rem; }
  .sec { background: #fff; border: 1px solid #E3E6E8; border-radius: 10px; }
  .sec__bar { display: flex; align-items: center; gap: .5rem; padding: .7rem .9rem; }
  .sec__bar .grow { flex: 1; min-width: 0; text-align: left; background: none; border: 0; font: inherit; cursor: pointer; padding: 0; color: var(--ink); }
  .sec__bar b { display: block; font-size: .92rem; font-weight: 600; }
  .sec__bar small { display: block; color: var(--ink-soft); font-size: .8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sec__num { flex: none; width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; background: #F1F3F4; font-size: .75rem; color: var(--ink-soft); }
  .mini { font: inherit; font-size: .78rem; padding: .3rem .55rem; border: 1px solid #D8DDE0; background: #fff; border-radius: 5px; cursor: pointer; color: var(--ink); }
  .mini:hover:not([disabled]) { border-color: var(--ink-soft); }
  .mini[disabled] { opacity: .4; cursor: default; }
  .mini.danger, .rep__bar .danger { color: #8A2B29; }
  .sec__body { border-top: 1px solid #EDEFF1; padding: 1rem .9rem .4rem; }
  .sec__note { background: #F4F7FA; border-radius: 6px; padding: .55rem .75rem; font-size: .85rem; color: var(--ink-soft); margin: 0 0 1rem; }
  .inp--md { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .84rem; }
  .inp--num { max-width: 120px; }
  .lbl { display: block; font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: .35rem; }
  .imgfld { display: flex; align-items: center; gap: .9rem; }
  .imgfld img { width: 120px; height: 80px; object-fit: cover; border-radius: 6px; background: #EEF0F2; }
  .imgfld img:not([src]) { display: none; }
  .imgfld__empty { width: 120px; height: 80px; display: grid; place-items: center; border-radius: 6px; border: 1px dashed #CFD5D9; font-size: .78rem; color: var(--ink-soft); }
  .imgfld img[src] + .imgfld__empty { display: none; }
  .rep { border: 0; padding: 0; }
  .rep__list { list-style: none; margin: 0 0 .6rem; padding: 0; display: grid; gap: .6rem; }
  .rep__item { border: 1px solid #E3E6E8; border-radius: 8px; padding: .6rem .75rem .1rem; background: #FBFBFC; }
  .rep__bar { display: flex; align-items: center; gap: .35rem; margin-bottom: .5rem; font-size: .82rem; text-transform: capitalize; }
  .rep__bar .spacer { flex: 1; }
  .rep__bar button { font: inherit; font-size: .76rem; padding: .2rem .5rem; border: 1px solid #D8DDE0; background: #fff; border-radius: 5px; cursor: pointer; }
  .rep__bar button[disabled] { opacity: .4; cursor: default; }
  .add-sec { width: 100%; justify-content: center; border-style: dashed; }
  .thumbs { list-style: none; margin: 0 0 .6rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: .5rem; max-height: 420px; overflow-y: auto; }
  .thumbs li { display: grid; gap: .25rem; }
  .thumbs img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 5px; background: #EEF0F2; }
  .thumbs__ctl { display: flex; gap: .2rem; }
  .thumbs__ctl button { flex: 1; font: inherit; font-size: .7rem; padding: .15rem; border: 1px solid #D8DDE0; background: #fff; border-radius: 4px; cursor: pointer; }
  .thumbs__ctl button[disabled] { opacity: .35; cursor: default; }
  .thumbs__ctl .danger { color: #8A2B29; }
  .savebar {
    position: sticky; bottom: 0; z-index: 5; margin-top: 1.25rem;
    display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
    background: #fff; border: 1px solid #E3E6E8; border-radius: 10px; padding: .75rem 1rem;
    box-shadow: 0 -8px 24px -16px rgb(16 24 32 / .35);
  }
  .savebar .spacer { flex: 1; }
  .savebar.is-dirty #dirty { color: #8A2B29; font-weight: 500; }
  #dirty { font-size: .88rem; color: var(--ink-soft); }

  .picker { width: min(760px, calc(100vw - 2rem)); max-height: calc(100vh - 3rem); border: 0; border-radius: 12px; padding: 1.25rem 1.4rem; box-shadow: 0 30px 80px -20px rgb(16 24 32 / .5); }
  .picker::backdrop { background: rgb(16 24 32 / .45); }
  .picker__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .picker__head h2 { margin: 0; font-size: 1.2rem; }
  .picker h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-soft); margin: 1.25rem 0 .6rem; }
  .picker__up { cursor: pointer; }
  .picker__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: .6rem; }
  .picker__grid button { padding: 0; border: 2px solid transparent; border-radius: 8px; background: none; cursor: pointer; display: grid; gap: .25rem; font-size: .75rem; color: var(--ink-soft); }
  .picker__grid button:hover, .picker__grid button:focus-visible { border-color: var(--maroon); }
  .picker__grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; background: #EEF0F2; }
  .types { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .6rem; }
  .types button { text-align: left; padding: .8rem .9rem; border: 1px solid #E3E6E8; border-radius: 8px; background: #fff; cursor: pointer; font: inherit; }
  .types button:hover, .types button:focus-visible { border-color: var(--maroon); background: #FBF6F6; }
  .types b { display: block; font-size: .92rem; margin-bottom: .15rem; }
  .types small { color: var(--ink-soft); font-size: .8rem; line-height: 1.4; }
  @media (max-width: 1000px) { .split--pages { grid-template-columns: 1fr; } }
</style>

<script>
  import { whenReady, esc, slugify, toast, explain } from '../../portal/client';
  import { BLOCK_FIELDS, renderFields, bindInput, getPath, setPath } from '../../portal/fields';
  import { pickImage, imageUrl } from '../../portal/imagePicker';
  import { BLOCK_TYPES, RESERVED_SLUGS, blankBlock, type Block, type BlockType } from '../../lib/blocks';

  // Built-in pages as shipped. Until someone saves one in the portal,
  // the site (and this editor) use these.
  const DEFAULTS = Object.values(import.meta.glob<any>('../../content/site/[!_]*.json', { eager: true, import: 'default' }));

  const { db, profile } = await whenReady();
  const byId = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = byId('list'), secs = byId('secs'), editor = byId('editor');
  const typeName = (t: BlockType) => BLOCK_TYPES.find((x) => x.type === t)?.name ?? t;
  const urlFor = (slug: string) => (slug === 'home' ? '/' : `/${slug}`);

  let pages: any[] = [];
  let page: any = null;      // working copy being edited
  let saved = '';            // JSON of the last saved state, to detect changes
  let open = new Set<string>();
  let isNew = false;
  let insertAt = 0;

  // Data ------------------------------------------------------------
  async function load() {
    const { data, error } = await db.from('site_pages').select('*');
    if (error) return toast(explain(error), 'error');
    const inDb = new Set(data.map((p) => p.slug));
    pages = [...data, ...DEFAULTS.filter((d) => !inDb.has(d.slug)).map((d) => ({ ...structuredClone(d), draft: false }))]
      .sort((a, b) => (a.slug === 'home' ? -1 : b.slug === 'home' ? 1 : Number(b.system) - Number(a.system) || a.title.localeCompare(b.title)));
    renderList();
    byId('site-links').innerHTML = pages.map((p) => `<option value="${urlFor(p.slug)}">${esc(p.title)}</option>`).join('')
      + '<option value="/events.ics">Calendar subscription</option><option value="/portal">Sign in</option>';
  }

  function renderList() {
    list.innerHTML = pages.length
      ? pages.map((p) => `<li><button type="button" data-slug="${esc(p.slug)}" aria-current="${page?.slug === p.slug && !isNew}">
          <b>${esc(p.title)}</b><small>${esc(urlFor(p.slug))}</small>
          ${p.draft ? '<span class="pill pill--draft">Draft</span>' : ''}</button></li>`).join('')
      : '<li><p class="empty">No pages found.</p></li>';
  }

  const dirty = () => JSON.stringify(page) !== saved;
  function markDirty() {
    const d = dirty();
    byId('savebar').classList.toggle('is-dirty', d);
    byId('dirty').textContent = d ? 'Unsaved changes' : 'All changes saved.';
  }
  window.addEventListener('beforeunload', (e) => { if (page && dirty()) e.preventDefault(); });

  // Page --------------------------------------------------------------
  function edit(p: any, asNew = false) {
    if (page && dirty() && !confirm('You have unsaved changes on this page. Discard them?')) return;
    isNew = asNew;
    page = structuredClone(p);
    saved = asNew ? '' : JSON.stringify(page);
    open = new Set();
    editor.hidden = false;
    byId<HTMLInputElement>('p-title').value = page.title;
    byId<HTMLInputElement>('p-slug').value = page.slug;
    byId<HTMLInputElement>('p-slug').disabled = page.system;
    byId('p-slug-hint').textContent = page.system ? `Built-in page: ${urlFor(page.slug)}` : `alpharettaorchestra.com${urlFor(page.slug || '…')}`;
    byId<HTMLInputElement>('p-desc').value = page.description ?? '';
    byId<HTMLInputElement>('p-draft').checked = page.draft;
    byId('p-draft-wrap').hidden = page.system;
    byId('del').hidden = page.system || asNew;
    const view = byId<HTMLAnchorElement>('view');
    view.href = urlFor(page.slug);
    view.hidden = asNew;
    renderSecs();
    renderList();
    markDirty();
  }

  for (const [id, key] of [['p-title', 'title'], ['p-desc', 'description']] as const) {
    byId<HTMLInputElement>(id).addEventListener('input', (e) => {
      page[key] = (e.target as HTMLInputElement).value;
      if (key === 'title' && isNew && !page._slugTouched) {
        page.slug = slugify(page.title);
        byId<HTMLInputElement>('p-slug').value = page.slug;
        byId('p-slug-hint').textContent = `alpharettaorchestra.com/${page.slug || '…'}`;
      }
      markDirty();
    });
  }
  byId<HTMLInputElement>('p-slug').addEventListener('input', (e) => {
    page.slug = (e.target as HTMLInputElement).value.trim();
    page._slugTouched = true;
    byId('p-slug-hint').textContent = `alpharettaorchestra.com/${page.slug || '…'}`;
    markDirty();
  });
  byId<HTMLInputElement>('p-draft').addEventListener('change', (e) => { page.draft = (e.target as HTMLInputElement).checked; markDirty(); });

  // Sections ------------------------------------------------------------
  function summary(b: Block): string {
    const s = (b as any).heading ?? (b as any).title ?? (b as any).text ?? (b as any).md ?? (b as any).caption ?? '';
    if (s) return String(s).replace(/[#*_\[\]()>]/g, '').slice(0, 90);
    if ('items' in b) return `${b.items.length} ${b.items.length === 1 ? 'item' : 'items'}`;
    if (b.type === 'gallery') return `${b.images.length} photos`;
    if (b.type === 'video') return b.url || 'No video yet';
    return BLOCK_FIELDS[b.type].note ?? '';
  }

  function renderSecs() {
    const blocks: Block[] = page.blocks;
    secs.innerHTML = blocks.map((b, i) => {
      const spec = BLOCK_FIELDS[b.type];
      const isOpen = open.has(b.id);
      return `<li class="sec" data-i="${i}">
        <div class="sec__bar">
          <span class="sec__num">${i + 1}</span>
          <button type="button" class="grow" data-act="toggle" data-i="${i}" aria-expanded="${isOpen}">
            <b>${esc(typeName(b.type))}</b><small>${esc(summary(b))}</small></button>
          <button type="button" class="mini" data-act="up" data-i="${i}" ${i === 0 ? 'disabled' : ''} aria-label="Move section up">Up</button>
          <button type="button" class="mini" data-act="down" data-i="${i}" ${i === blocks.length - 1 ? 'disabled' : ''} aria-label="Move section down">Down</button>
          <button type="button" class="mini" data-act="add" data-at="${i + 1}" aria-label="Add a section below">Add below</button>
          <button type="button" class="mini danger" data-act="rm" data-i="${i}">Remove</button>
        </div>
        ${isOpen ? `<div class="sec__body">
          ${spec.note ? `<p class="sec__note">${esc(spec.note)}</p>` : ''}
          ${renderFields(spec.fields, b, `blocks.${i}`)}
        </div>` : ''}
      </li>`;
    }).join('') || '<li><p class="empty">No sections yet. Add the first one below.</p></li>';
    // Image previews
    secs.querySelectorAll<HTMLImageElement>('img[data-ref]').forEach((img) => {
      const src = imageUrl(img.dataset.ref);
      if (src) img.src = src;
    });
    secs.querySelectorAll<HTMLElement>('[data-image]').forEach((el) => {
      const src = imageUrl(getPath(page, el.dataset.image!));
      const img = el.querySelector('img')!;
      if (src) img.src = src; else img.removeAttribute('src');
    });
  }

  secs.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (!el.dataset.path) return;
    bindInput(page, el);
    markDirty();
    // Keep the collapsed summary in step with what's typed.
    const li = el.closest<HTMLElement>('.sec');
    if (li) li.querySelector('small')!.textContent = summary(page.blocks[Number(li.dataset.i)]);
  });
  secs.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.kind === 'check' || el.tagName === 'SELECT') { bindInput(page, el); markDirty(); }
  });

  editor.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
    if (!b) return;
    const blocks: Block[] = page.blocks;
    const i = Number(b.dataset.i);
    const act = b.dataset.act;
    if (act === 'toggle') { const id = blocks[i].id; open.has(id) ? open.delete(id) : open.add(id); }
    else if (act === 'up' || act === 'down') {
      const j = act === 'up' ? i - 1 : i + 1;
      [blocks[i], blocks[j]] = [blocks[j], blocks[i]];
    } else if (act === 'rm') {
      if (!confirm(`Remove this ${typeName(blocks[i].type).toLowerCase()} section?`)) return;
      blocks.splice(i, 1);
    } else if (act === 'add') {
      insertAt = b.dataset.at === 'end' ? blocks.length : Number(b.dataset.at);
      byId<HTMLDialogElement>('types').showModal();
      return;
    } else if (act === 'img-add') {
      const ref = await pickImage(db);
      if (!ref) return;
      const arr: string[] = getPath(page, b.dataset.path!) ?? [];
      setPath(page, b.dataset.path!, [...arr, ref]);
    } else if (act === 'img-rm' || act === 'img-move') {
      const arr: string[] = [...(getPath(page, b.dataset.path!) ?? [])];
      if (act === 'img-rm') arr.splice(i, 1);
      else { const j = i + Number(b.dataset.step); [arr[i], arr[j]] = [arr[j], arr[i]]; }
      setPath(page, b.dataset.path!, arr);
    } else if (act === 'pick-image') {
      const ref = await pickImage(db);
      if (!ref) return;
      setPath(page, b.dataset.path!, ref);
    } else if (act?.startsWith('rep-')) {
      const arr: any[] = getPath(page, b.dataset.path!) ?? [];
      if (!Array.isArray(getPath(page, b.dataset.path!))) setPath(page, b.dataset.path!, arr);
      if (act === 'rep-add') arr.push({});
      if (act === 'rep-rm') arr.splice(i, 1);
      if (act === 'rep-up') [arr[i - 1], arr[i]] = [arr[i], arr[i - 1]];
      if (act === 'rep-down') [arr[i + 1], arr[i]] = [arr[i], arr[i + 1]];
    } else return;
    renderSecs();
    markDirty();
  });

  byId('types').addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-type]')?.dataset.type as BlockType | undefined;
    if (!t) return;
    const blk = blankBlock(t);
    page.blocks.splice(insertAt, 0, blk);
    open.add(blk.id);
    byId<HTMLDialogElement>('types').close();
    renderSecs();
    markDirty();
    secs.querySelector(`.sec[data-i="${insertAt}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  // Save / delete ------------------------------------------------------
  function problems(): string | null {
    if (!page.title?.trim()) return 'Give the page a title.';
    if (!page.system) {
      if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(page.slug ?? '')) return 'The web address can only use lowercase letters, numbers and dashes.';
      if (RESERVED_SLUGS.includes(page.slug)) return 'That web address is used by the site itself. Pick another.';
      if (isNew && pages.some((p) => p.slug === page.slug)) return 'A page with that web address already exists.';
    }
    for (const [n, b] of (page.blocks as Block[]).entries()) {
      if ((b.type === 'hero' || b.type === 'image' || b.type === 'split') && !b.image) return `Section ${n + 1} (${typeName(b.type)}) needs a photo.`;
      if (b.type === 'heading' && !b.title?.trim()) return `Section ${n + 1} needs a title.`;
    }
    return null;
  }

  byId('save').addEventListener('click', async () => {
    const p = problems();
    if (p) return toast(p, 'error');
    const row = { slug: page.slug, title: page.title.trim(), description: page.description?.trim() || null,
      blocks: page.blocks, draft: Boolean(page.draft), updated_by: profile.id };
    const btn = byId<HTMLButtonElement>('save');
    btn.disabled = true;
    const original = isNew ? null : pages.find((x) => x.slug === JSON.parse(saved).slug);
    // Built-in pages may not be in the database yet (first save), so upsert;
    // custom pages can be renamed, so update by their old address.
    const res = isNew
      ? await db.from('site_pages').insert(row).select().single()
      : page.system
        ? await db.from('site_pages').upsert({ ...row, system: true }, { onConflict: 'slug' }).select().single()
        : await db.from('site_pages').update(row).eq('slug', original.slug).select().single();
    btn.disabled = false;
    if (res.error) return toast(explain(res.error), 'error');
    toast('Saved. The website shows it after its next update, usually within a few minutes.');
    isNew = false;
    await load();
    page = structuredClone(res.data);
    saved = JSON.stringify(page);
    edit(res.data);
  });

  byId('revert').addEventListener('click', () => {
    if (!dirty()) return;
    if (!confirm('Undo all changes since the last save?')) return;
    const orig = saved ? JSON.parse(saved) : null;
    page = null;
    if (orig) edit(orig); else { editor.hidden = true; }
  });

  byId('del').addEventListener('click', async () => {
    if (!page || page.system || !confirm(`Delete the page “${page.title}”? Links to it will stop working.`)) return;
    const { error } = await db.from('site_pages').delete().eq('slug', page.slug);
    if (error) return toast(explain(error), 'error');
    toast('Page deleted.');
    page = null;
    editor.hidden = true;
    load();
  });

  list.addEventListener('click', (e) => {
    const slug = (e.target as HTMLElement).closest<HTMLButtonElement>('button')?.dataset.slug;
    const p = pages.find((x) => x.slug === slug);
    if (p) edit(p);
  });

  byId('new').addEventListener('click', () => {
    const blank = { slug: '', title: '', description: '', system: false, draft: true,
      blocks: [{ ...blankBlock('heading'), title: 'New page' }, blankBlock('text')] };
    edit(blank, true);
    open = new Set(blank.blocks.map((b) => b.id));
    renderSecs();
    byId<HTMLInputElement>('p-title').focus();
    toast('New pages start as drafts. Untick “Hidden” when it’s ready, and add it to the menu under Menu & footer.');
  });

  await load();
  const want = new URLSearchParams(location.search).get('page');
  const first = pages.find((p) => p.slug === (want ?? 'home'));
  if (first) edit(first);
</script>
