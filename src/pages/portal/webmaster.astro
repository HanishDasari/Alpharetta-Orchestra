---
import Portal from '../../layouts/Portal.astro';
---

<Portal title="Dashboard" roles={['webmaster']}>
  <h1 id="hello">Dashboard</h1>
  <p class="sub">Keep the website current. Everything you change goes live on the site&rsquo;s next update.</p>

  <div class="tiles">
    <a class="tile" href="/portal/events"><span class="tile__n" id="t-events">&ndash;</span><b>Upcoming concerts</b><small id="t-events-sub">&nbsp;</small></a>
    <a class="tile" href="/portal/news"><span class="tile__n" id="t-news">&ndash;</span><b>Announcements</b><small id="t-news-sub">&nbsp;</small></a>
    <a class="tile" href="/portal/photos"><span class="tile__n" id="t-photos">&ndash;</span><b>Ring photos</b><small>On the homepage</small></a>
  </div>

  <section class="card">
    <h2>What you can edit</h2>
    <ul class="list">
      <li><a class="row" href="/portal/events"><b>Concerts &amp; Events</b><small>The calendar, homepage and subscribe feed</small></a></li>
      <li><a class="row" href="/portal/news"><b>Announcements</b></a></li>
      <li><a class="row" href="/portal/pages"><b>Pages</b><small>About, Director, Instruments</small></a></li>
      <li><a class="row" href="/portal/ensembles"><b>Orchestras</b></a></li>
      <li><a class="row" href="/portal/photos"><b>Photos</b></a></li>
    </ul>
  </section>

  <section class="card">
    <h2>What this account can&rsquo;t reach</h2>
    <div class="locked">
      <span>The roster, the daily board, forms and their answers, the site&rsquo;s design settings, and anything to do with money.
      That&rsquo;s enforced by the database, so it holds even if someone shares this login. When you graduate, Mr. Hood switches this account off.</span>
    </div>
  </section>
</Portal>

<script>
  import { whenReady, fmtDate, fmtDay } from '../../portal/client';

  const { db, profile } = await whenReady();
  const set = (id: string, v: string) => (document.getElementById(id)!.textContent = v);
  if (profile.full_name) set('hello', `Hi, ${profile.full_name.split(' ')[0]}`);

  const [ev, news, photos] = await Promise.all([
    db.from('events').select('title, start_at, all_day', { count: 'exact' }).eq('draft', false).gte('start_at', new Date().toISOString()).order('start_at').limit(1),
    db.from('news').select('date', { count: 'exact' }).eq('draft', false).order('date', { ascending: false }).limit(1),
    db.from('ring_photos').select('id', { count: 'exact', head: true }),
  ]);
  set('t-events', String(ev.count ?? 0));
  const next = ev.data?.[0];
  set('t-events-sub', next ? `Next: ${fmtDate(next.start_at, next.all_day ? { timeZone: 'UTC', month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric' })}` : 'Nothing scheduled');
  set('t-news', String(news.count ?? 0));
  set('t-news-sub', news.data?.[0] ? `Last posted ${fmtDay(news.data[0].date, { month: 'short', day: 'numeric' })}` : 'None yet');
  set('t-photos', String(photos.count ?? 0));
</script>
