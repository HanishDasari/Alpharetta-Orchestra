---
import { photos } from '../lib/photos';

/* Duplicates the current site's header: fixed maroon band, centered
   logo, and one centered nav list that wraps onto three rows at
   desktop width. Link order matches the live site exactly. */
const nav = [
  { label: 'Uniforms', href: '/students' },
  { label: 'Orchestra 101', href: '/students' },
  { label: 'About', href: '/about' },
  { label: 'Calendar', href: '/calendar' },
  { label: 'Store', href: '/support' },
  { label: 'Program Book', href: '/support' },
  { label: 'Orchestra Memories', href: '/calendar' },
  { label: 'Past Events', href: '/calendar' },
  { label: 'Student Resources', href: '/students' },
  { label: 'Orchestra Opportunities', href: '/students' },
  { label: 'Contact', href: '/about' },
  { label: 'Donate', href: '/support' },
  { label: 'Patron Program', href: '/support' },
];
---

<a class="skip" href="#main">Skip to Content</a>

<header class="hdr">
  <a class="hdr__logo" href="/">
    <img src={photos.logo} alt="Alpharetta High School Orchestras" width="450" height="150" />
  </a>

  <input type="checkbox" id="nav-toggle" class="vh" />
  <label for="nav-toggle" class="burger" aria-label="Menu"><span></span></label>

  <nav class="hdr__nav" aria-label="Main">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<style>
  .vh {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .skip { position: absolute; left: -9999px; background: #fff; color: var(--maroon); padding: .75rem 1.25rem; z-index: 100; }
  .skip:focus { left: 1rem; top: 1rem; }

  .hdr {
    position: fixed; inset: 0 0 auto; z-index: 10;
    background: var(--maroon);
    display: flex; flex-direction: column; align-items: center;
    padding-bottom: 14px; /* brings the band to the live site's 250px */
  }

  .hdr__logo { display: block; line-height: 0; }
  .hdr__logo img { width: 450px; height: 150px; max-width: 90vw; object-fit: contain; }

  .hdr__nav {
    display: flex; flex-wrap: wrap; justify-content: center;
    max-width: 640px; padding: 0 1rem;
  }
  .hdr__nav a {
    color: #fff; text-decoration: none;
    font-size: 16px; font-weight: 300; line-height: 28.8px;
    padding: 0 .5rem;
    transition: opacity .18s ease;
  }
  .hdr__nav a:hover { opacity: .7; text-decoration: underline; }

  .burger { display: none; }

  @media (max-width: 900px) {
    .hdr { padding-bottom: 0; }
    .hdr__logo img { width: 280px; height: 93px; }

    .burger {
      display: block; width: 30px; height: 22px;
      position: absolute; top: 1.25rem; right: 1.25rem; cursor: pointer;
    }
    .burger span, .burger::before, .burger::after {
      content: ''; position: absolute; left: 0;
      width: 100%; height: 2px; background: #fff;
      transition: transform .22s ease, opacity .22s ease;
    }
    .burger::before { top: 0; }
    .burger span { top: 10px; }
    .burger::after { bottom: 0; }

    .hdr__nav {
      flex-direction: column; align-items: center; width: 100%;
      max-height: 0; overflow: hidden;
      transition: max-height .3s ease;
    }
    .hdr__nav a { padding: .55rem 0; }

    #nav-toggle:checked ~ .hdr__nav { max-height: 32rem; padding-bottom: 1rem; }
    #nav-toggle:checked ~ .burger span { opacity: 0; }
    #nav-toggle:checked ~ .burger::before { top: 10px; transform: rotate(45deg); }
    #nav-toggle:checked ~ .burger::after { bottom: 10px; transform: rotate(-45deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__nav, .burger span, .burger::before, .burger::after { transition: none; }
  }
</style>
