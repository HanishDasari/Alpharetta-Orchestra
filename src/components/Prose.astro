---
// Shared typographic wrapper for Markdown-rendered content.
---
<div class="prose"><slot /></div>

<style>
  .prose { max-width: var(--measure); }
  .prose :global(h2) {
    font-size: var(--step-1);
    margin-top: 2.5rem;
    padding-top: 0.25rem;
  }
  .prose :global(h3) { font-size: var(--step-0); font-weight: 600; margin-top: 1.75rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2rem; margin-bottom: 1.4rem; }
  .prose :global(li) { margin-bottom: 0.45rem; }
  .prose :global(li)::marker { color: var(--silver); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--maroon);
    color: var(--ink-soft);
  }
</style>
