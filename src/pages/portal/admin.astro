---
import Portal from '../../layouts/Portal.astro';
---

<Portal title="Dashboard" roles={['admin']}>
  <h1 id="hello">Dashboard</h1>
  <p class="sub">The website, the classroom, and your roster.</p>

  <div class="tiles">
    <a class="tile" href="/portal/events"><span class="tile__n" id="t-events">&ndash;</span><b>Upcoming concerts</b><small id="t-events-sub">&nbsp;</small></a>
    <a class="tile" href="/portal/admin/board"><span class="tile__n" id="t-board">&ndash;</span><b>Today&rsquo;s board</b><small id="t-board-sub">&nbsp;</small></a>
    <a class="tile" href="/portal/admin/forms"><span class="tile__n" id="t-forms">&ndash;</span><b>Open forms</b><small id="t-forms-sub">&nbsp;</small></a>
    <a class="tile" href="/portal/roster"><span class="tile__n" id="t-roster">&ndash;</span><b>Students</b><small>On the roster</small></a>
  </div>

  <div class="split split--even">
    <section class="card">
      <h2>Website</h2>
      <ul class="list">
        <li><a class="row" href="/portal/events"><b>Concerts &amp; Events</b><small>Add once: homepage, calendar and subscribed phones all update</small></a></li>
        <li><a class="row" href="/portal/news"><b>Announcements</b><small>News for families and the community</small></a></li>
        <li><a class="row" href="/portal/pages"><b>Pages</b><small>Every page on the site, section by section, and new pages</small></a></li>
        <li><a class="row" href="/portal/menu"><b>Menu &amp; footer</b><small>The links at the top and bottom of every page</small></a></li>
        <li><a class="row" href="/portal/ensembles"><b>Orchestras</b><small>The six ensembles and their requirements</small></a></li>
        <li><a class="row" href="/portal/photos"><b>Photos</b><small>The spinning photo ring on the homepage</small></a></li>
        <li><a class="row" href="/portal/admin/design"><b>Design &amp; Appearance</b><small>Colours, fonts, homepage sections</small></a></li>
      </ul>
    </section>

    <section class="card">
      <h2>Classroom</h2>
      <ul class="list">
        <li><a class="row" href="/portal/admin/board"><b>Daily Board</b><small>Write it, present it, students catch up later</small></a></li>
        <li><a class="row" href="/portal/admin/slides"><b>Presentations</b><small>Build slides and present them full screen, like Google Slides</small></a></li>
        <li><a class="row" href="/portal/admin/forms"><b>Forms</b><small>Slips and sign-ups with QR codes and a who-hasn&rsquo;t-answered list</small></a></li>
        <li><a class="row" href="/portal/roster"><b>Roster</b><small>Students, ensembles, and which logins belong to whom</small></a></li>
        <li><a class="row" href="/portal/student"><b>View as a student</b><small>See exactly what students see</small></a></li>
        <li><a class="row" href="/portal/family"><b>View as a family</b><small>See what parents see (without the fees)</small></a></li>
      </ul>
      <div class="locked" style="margin-top:1rem">
        <span><b style="display:block;color:var(--ink);margin-bottom:.2rem">No fees or payments here</b>
        Those belong to the booster treasurer. The database refuses to show them to the director&rsquo;s account, not just the menus.</span>
      </div>
    </section>
  </div>
</Portal>

<style>
  .split--even { grid-template-columns: 1fr 1fr; }
  @media (max-width: 1000px) { .split--even { grid-template-columns: 1fr; } }
</style>

<script>
  import { whenReady, fmtDate, schoolToday } from '../../portal/client';

  const { db, profile } = await whenReady();
  const set = (id: string, v: string) => (document.getElementById(id)!.textContent = v);
  if (profile.full_name) set('hello', `Hi, ${profile.full_name.split(' ')[0]}`);

  const now = new Date().toISOString();
  const [ev, board, forms, roster] = await Promise.all([
    db.from('events').select('title, start_at, all_day', { count: 'exact' }).eq('draft', false).gte('start_at', now).order('start_at').limit(1),
    db.from('boards').select('published, body').eq('board_date', schoolToday()).maybeSingle(),
    db.from('forms').select('id', { count: 'exact', head: true }).eq('open', true),
    db.from('students').select('id', { count: 'exact', head: true }),
  ]);

  set('t-events', String(ev.count ?? 0));
  const next = ev.data?.[0];
  set('t-events-sub', next ? `Next: ${next.title}, ${fmtDate(next.start_at, next.all_day ? { timeZone: 'UTC', month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric' })}` : 'Nothing scheduled');
  set('t-board', board.data ? (board.data.published ? 'Live' : 'Draft') : 'None');
  set('t-board-sub', board.data ? (board.data.published ? 'Students can see it' : 'Students see it tomorrow') : 'Write today’s board');
  set('t-forms', String(forms.count ?? 0));
  set('t-forms-sub', forms.count ? 'Collecting answers' : 'Nothing out right now');
  set('t-roster', String(roster.count ?? 0));
</script>
