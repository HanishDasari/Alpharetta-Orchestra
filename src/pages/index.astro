---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import EventCard from '../components/EventCard.astro';
import PhotoRing from '../components/PhotoRing.astro';
import { photos, ringPhotos } from '../lib/photos';
import { upcomingEvents } from '../lib/events';
import { getRingPhotoPaths, getSettings } from '../lib/content';
import { ringPhotoUrl } from '../lib/supabase';

/* Duplicate of the current homepage, section for section:
     1. full-bleed hero photo (no text on it)
     2. white band — photo left, intro copy right
     3. silver band — three alternating photo/text rows
     4. white band — left-aligned Dudamel quote
   Two additions: the next few concerts, and the photo ring. */

const next = await upcomingEvents(3);

// Photos uploaded in the portal replace the ones in src/assets.
const uploaded = await getRingPhotoPaths();
const ring = uploaded.length ? uploaded.map(ringPhotoUrl) : ringPhotos;

// Design & Appearance can hide the sections added to the original layout.
const show = { next: true, memories: true, quote: true, ...(await getSettings()).sections };

const rows = [
  {
    title: 'About the Program',
    img: photos.program,
    flip: false,
    body:
      'The nationally recognized Alpharetta High School orchestra program was ' +
      'established in the fall of 2004 and is comprised of six orchestras and ' +
      'about 130 members. Alpharetta High School Orchestras strive for ' +
      'excellence in music education at the high school level.',
    href: '/about',
  },
  {
    title: 'The Orchestras',
    img: photos.orchestras,
    flip: true,
    body:
      'The Alpharetta High School Orchestra program is made up of six ensembles: ' +
      'the Concert, Silver, Philharmonia, Sinfonia, Symphony, and Chamber ' +
      'orchestras. The orchestras have consistently achieved Superior ratings at ' +
      'adjudications and have travelled to perform locally, statewide, and nationally.',
    href: '/orchestras',
  },
  {
    title: 'About the Director',
    img: photos.director,
    flip: false,
    body: 'Jake Hood was named Director of Orchestras at Alpharetta High School in 2022.',
    href: '/about#director',
  },
];
---

<Base title="home">
  <!-- 1. Hero photo, full bleed, no overlay text ------------------ -->
  <section class="hero">
    <Image src={photos.hero} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
  </section>

  <!-- 2. Intro: photo left, copy right ---------------------------- -->
  <section class="intro">
    <div class="wrap duo">
      <Image class="intro__img" src={photos.intro} alt="" widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 590px" />
      <div>
        <p>
          The Alpharetta High School Orchestra, located in Alpharetta, Georgia
          has approximately 130 students participating in 6 distinct levels of
          daily string/orchestra instruction. The program focuses on improving
          string technique, musicianship, ear training, and both solo and
          ensemble playing to prepare students to be thriving, independent
          musicians. The orchestra program has students who are extremely
          enthusiastic and dedicated to their craft.
        </p>
        <p>
          The orchestra is fortunate to have incredible facilities and
          equipment, a supportive administrative team, and an amazing parent
          booster organization.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Silver band: three alternating rows ---------------------- -->
  <section class="feat">
    <div class="wrap">
      {rows.map((r) => (
        <div class:list={['duo', 'feat__row', r.flip && 'duo--flip']}>
          <Image class="feat__img" src={r.img} alt="" widths={[600, 1100]} sizes="(max-width: 900px) 100vw, 540px" />
          <div>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
            <a href={r.href} class="btn-learn">Learn More</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Addition: the next few concerts -->
  {show.next && (
  <section class="next" id="next">
    <div class="wrap">
      <h2>Coming up</h2>
      {next.length > 0 ? (
        <div class="next__list">
          {next.map((e) => (
            <EventCard
              title={e.data.title}
              start={e.data.start}
              allDay={e.data.allDay}
              location={e.data.location}
              ensembles={e.data.ensembles}
              summary={e.data.summary}
              href={`/events/${e.slug}`}
            />
          ))}
        </div>
      ) : (
        <p class="next__empty">No concerts on the calendar right now. Check back soon.</p>
      )}
      <p class="next__links">
        <a href="/calendar">Full calendar</a>
        <a href="/events.ics">Add to your calendar</a>
      </p>
    </div>
  </section>
  )}

  <!-- Addition: photo ring -------------------------------- -->
  {show.memories && (
  <section class="memories" id="memories">
    <div class="wrap">
      <h2>Orchestra Memories</h2>
    </div>
    <PhotoRing photos={ring} label="Photos of the Alpharetta High School Orchestras in rehearsal and performance" />
  </section>
  )}

  <!-- 4. Quote, left aligned -------------------------------------- -->
  {show.quote && (
  <section class="quote">
    <div class="wrap">
      <h2>&ldquo;With an orchestra, you are building citizens, better citizens for the community.&rdquo;</h2>
      <p>&mdash; Gustavo Dudamel</p>
    </div>
  </section>
  )}
</Base>

<style>
  /* The header is fixed and overlays the top of the hero photo,
     exactly as it does on the live site. */
  .hero { height: 528px; overflow: hidden; }
  .hero img { width: 100%; height: 100%; object-fit: cover; }

  .intro { background: #fff; padding-block: 42px 104px; }
  .intro__img { width: 100%; aspect-ratio: 589 / 393; object-fit: cover; }

  .feat { background: var(--silver); color: #fff; padding-block: 85px; }
  .feat__row + .feat__row { margin-top: 121px; }
  .feat__img { width: 100%; aspect-ratio: 539 / 358; object-fit: cover; }
  .feat h3 { color: #fff; margin-bottom: 28px; }
  .feat p { margin-bottom: 40px; }

  .next { background: #fff; padding-block: 85px 64px; }
  .next h2 { margin-bottom: 28px; }
  .next__list { display: grid; gap: 1rem; max-width: 860px; }
  .next__empty { color: var(--ink-soft); }
  .next__links { display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; margin-top: 1.75rem; font-weight: 500; }

  .memories { background: var(--paper-off); padding-block: 85px 72px; overflow-x: clip; }
  .memories h2 { margin-bottom: 8px; }

  .quote { background: #fff; padding-block: 85px; }
  .quote h2 { max-width: 589px; margin-bottom: 32px; }
  .quote p { margin: 0; }

  @media (max-width: 900px) {
    .hero { height: 300px; }
    .intro { padding-block: 32px 56px; }
    .feat { padding-block: 56px; }
    .feat__row + .feat__row { margin-top: 64px; }
    .next { padding-block: 56px 40px; }
    .memories { padding-block: 56px 48px; }
    .quote { padding-block: 56px; }
  }
</style>
