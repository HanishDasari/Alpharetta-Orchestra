---
import Portal from '../../layouts/Portal.astro';
import Placeholder from '../../components/Placeholder.astro';
import FeatureBrief from '../../components/FeatureBrief.astro';

const points = [
  {
    what: 'Today’s board, without asking anyone',
    why: 'The same slide that was on the projector. A student who walked in late or sat in the back can read it again on their phone.',
  },
  {
    what: 'Every past day, by date',
    why: 'Absent students catch up themselves instead of asking Mr. Hood at the start of the next class. That question is the single most repeated interruption in a rehearsal room.',
  },
  {
    what: 'Forms they still owe, in one list',
    why: 'Right now a student has no way to know they missed a form until someone chases them. This shows what is outstanding.',
  },
  {
    what: 'Their own concert dates',
    why: 'Filtered to their ensemble, so a Concert Orchestra freshman is not scrolling past Chamber events that do not apply to them.',
  },
  {
    what: 'Works on a phone',
    why: 'This is the only screen students will actually open, and they will open it on a phone in the hallway. It is designed for that first.',
  },
];
---

<Portal title="Today" role="student">
  <h1>Today</h1>
  <p class="sub">Symphony Orchestra &middot; 4th period</p>

  <section class="card" id="today">
    <h2>Today&rsquo;s board</h2>
    <Placeholder
      label="Today's board goes here"
      note="Whatever Mr. Hood put on the projector this morning, posted here automatically at the end of the day."
      height="260px"
    />
  </section>

  <section class="card" id="past">
    <h2>Past boards</h2>
    <Placeholder
      label="Past boards go here"
      note="Every previous day, so if you were absent you can see exactly what you missed."
      height="180px"
    />
  </section>

  <section class="card" id="forms">
    <h2>Forms to fill</h2>
    <Placeholder
      label="Forms go here"
      note="Anything assigned to you that still needs answering."
      height="160px"
    />
  </section>

  <FeatureBrief points={points} />

  <section class="card">
    <h2>Not built yet</h2>
    <div class="locked">
      <span aria-hidden="true" style="font-size:1.1rem;line-height:1">🔧</span>
      <span>
        <b style="display:block;color:var(--ink);margin-bottom:.25rem">
          These are tabs, not features
        </b>
        They show where the daily board and forms would appear for students
        once those are built.
      </span>
    </div>
  </section>
</Portal>
