---
import Portal from '../../../layouts/Portal.astro';
import { FONTS } from '../../../lib/design';

const fonts = Object.keys(FONTS);
---

<Portal title="Design & Appearance" roles={['admin']}>
  <div class="head">
    <div>
      <h1>Design &amp; Appearance</h1>
      <p class="sub">Colours, fonts and which homepage sections show. Nothing here can break the layout.</p>
    </div>
  </div>

  <form id="form" class="split split--design" novalidate>
    <div>
      <section class="card">
        <h2>Brand colours</h2>
        <div class="row3">
          <div class="fld"><label for="maroon">Main colour</label><input class="inp inp--color" id="maroon" name="maroon" type="color" /><p class="hint">Header, buttons, links</p></div>
          <div class="fld"><label for="maroonBright">Hover colour</label><input class="inp inp--color" id="maroonBright" name="maroonBright" type="color" /><p class="hint">Buttons when pointed at</p></div>
          <div class="fld"><label for="ink">Text colour</label><input class="inp inp--color" id="ink" name="ink" type="color" /><p class="hint">Body text and headings</p></div>
        </div>
        <p class="hint" id="contrast" role="status"></p>
      </section>

      <section class="card">
        <h2>Typefaces</h2>
        <div class="row2">
          <div class="fld">
            <label for="fontDisplay">Headings</label>
            <select class="inp" id="fontDisplay" name="fontDisplay">{fonts.map((x) => <option>{x}</option>)}</select>
          </div>
          <div class="fld">
            <label for="fontBody">Body text</label>
            <select class="inp" id="fontBody" name="fontBody">{fonts.map((x) => <option>{x}</option>)}</select>
          </div>
        </div>
      </section>

      <section class="card">
        <h2>Header and homepage</h2>
        <fieldset class="fld">
          <legend>Header size</legend>
          <label class="check"><input type="radio" name="headerSize" value="regular" /> Regular (as now)</label>
          <label class="check"><input type="radio" name="headerSize" value="compact" /> Compact: smaller logo, more of the page visible</label>
        </fieldset>
        <fieldset class="fld">
          <legend>Homepage sections</legend>
          <label class="check"><input type="checkbox" name="s_next" /> Coming up (next concerts)</label>
          <label class="check"><input type="checkbox" name="s_memories" /> Orchestra Memories (photo ring)</label>
          <label class="check"><input type="checkbox" name="s_quote" /> Dudamel quote</label>
        </fieldset>
      </section>

      <div class="actions">
        <button class="pbtn pbtn--primary" type="submit" id="save">Save and publish</button>
        <button class="pbtn pbtn--ghost" type="button" id="reset">Back to the original look</button>
      </div>
    </div>

    <section class="card preview" aria-labelledby="pv-h">
      <h2 id="pv-h">Preview</h2>
      <div class="pv" id="pv">
        <div class="pv__band"><span>ALPHARETTA ORCHESTRA</span></div>
        <div class="pv__body">
          <p class="pv__h">Concerts &amp; events</p>
          <p class="pv__p">Everything on one page. Subscribe once and new concerts show up in your phone&rsquo;s calendar automatically.</p>
          <p><span class="pv__btn">Subscribe to calendar</span> <a class="pv__a" href="#pv">Full calendar</a></p>
        </div>
      </div>
    </section>
  </form>
</Portal>

<style>
  .split--design { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .inp--color { height: 44px; padding: 4px; cursor: pointer; }
  fieldset.fld .check { margin-bottom: .35rem; }
  .preview { position: sticky; top: 1rem; }
  .pv { border: 1px solid #E3E6E8; border-radius: 8px; overflow: hidden; background: #fff; }
  .pv__band { background: var(--pv-maroon); color: #fff; padding: 1.1rem; text-align: center; font-family: var(--pv-display); font-weight: 600; letter-spacing: .06em; }
  .pv__body { padding: 1.25rem; color: var(--pv-ink); font-family: var(--pv-body); }
  .pv__h { font-family: var(--pv-display); font-size: 1.6rem; font-weight: 500; line-height: 1.2; margin: 0 0 .5rem; }
  .pv__p { font-weight: 300; line-height: 1.6; margin: 0 0 1rem; }
  .pv__btn { display: inline-block; background: var(--pv-maroon); color: #fff; padding: .55rem 1rem; border-radius: 999px; font-size: .85rem; transition: background-color .15s ease; }
  .pv__btn:hover { background: var(--pv-bright); }
  .pv__a { color: var(--pv-maroon); margin-left: .75rem; font-size: .9rem; }
  @media (max-width: 1000px) { .split--design { grid-template-columns: 1fr; } .preview { position: static; } }
</style>

<script>
  import { whenReady, toast, explain } from '../../../portal/client';
  import { DEFAULT_COLORS, DEFAULT_FONTS, resolveDesign, fontsHref } from '../../../lib/design';

  const { db, profile } = await whenReady();
  const form = document.getElementById('form') as HTMLFormElement;
  const pv = document.getElementById('pv')!;
  const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  const fontLink = document.createElement('link');
  fontLink.rel = 'stylesheet';
  document.head.append(fontLink);

  // WCAG contrast between two hex colours.
  function lum(hex: string) {
    const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
      .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
  }
  const ratio = (a: string, b: string) => { const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };

  function read() {
    return {
      colors: { maroon: el('maroon').value, maroonBright: el('maroonBright').value, ink: el('ink').value },
      fontDisplay: (form.elements.namedItem('fontDisplay') as HTMLSelectElement).value,
      fontBody: (form.elements.namedItem('fontBody') as HTMLSelectElement).value,
      headerSize: (form.querySelector('[name="headerSize"]:checked') as HTMLInputElement)?.value ?? 'regular',
      sections: { next: el('s_next').checked, memories: el('s_memories').checked, quote: el('s_quote').checked },
    };
  }

  function preview() {
    const s = read();
    pv.style.setProperty('--pv-maroon', s.colors.maroon);
    pv.style.setProperty('--pv-bright', s.colors.maroonBright);
    pv.style.setProperty('--pv-ink', s.colors.ink);
    pv.style.setProperty('--pv-display', `'${s.fontDisplay}', sans-serif`);
    pv.style.setProperty('--pv-body', `'${s.fontBody}', sans-serif`);
    fontLink.href = fontsHref([s.fontDisplay, s.fontBody]);
    const r1 = ratio(s.colors.maroon, '#ffffff'), r2 = ratio(s.colors.ink, '#ffffff');
    const warn = [];
    if (r1 < 4.5) warn.push(`white text on the main colour is hard to read (${r1.toFixed(1)}:1, needs 4.5)`);
    if (r2 < 7) warn.push(`body text is low contrast (${r2.toFixed(1)}:1, aim for 7)`);
    const c = document.getElementById('contrast')!;
    c.textContent = warn.length ? `Heads up: ${warn.join('; ')}.` : 'Contrast is good.';
    c.style.color = warn.length ? '#8A2B29' : '';
    return { s, ok: r1 >= 4.5 };
  }

  function fill(raw: any) {
    const d = resolveDesign(raw);
    el('maroon').value = d.colors.maroon.toLowerCase();
    el('maroonBright').value = d.colors.maroonBright.toLowerCase();
    el('ink').value = d.colors.ink.toLowerCase();
    (form.elements.namedItem('fontDisplay') as HTMLSelectElement).value = d.fontDisplay;
    (form.elements.namedItem('fontBody') as HTMLSelectElement).value = d.fontBody;
    (form.querySelector(`[name="headerSize"][value="${d.headerSize}"]`) as HTMLInputElement).checked = true;
    const sec = { next: true, memories: true, quote: true, ...(raw?.sections ?? {}) };
    el('s_next').checked = sec.next; el('s_memories').checked = sec.memories; el('s_quote').checked = sec.quote;
    preview();
  }

  form.addEventListener('input', preview);
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const { s, ok } = preview();
    if (!ok && !confirm('White text on that main colour will be hard to read in the header and buttons. Save anyway?')) return;
    const btn = document.getElementById('save') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await db.from('site_settings').update({ settings: s, updated_by: profile.id }).eq('id', 1);
    btn.disabled = false;
    if (error) return toast(explain(error), 'error');
    toast('Saved. The website picks up the new look on its next update.');
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    fill({ colors: DEFAULT_COLORS, fontDisplay: DEFAULT_FONTS.display, fontBody: DEFAULT_FONTS.body, headerSize: 'regular' });
    toast('Back to the original look. Save to publish it.');
  });

  const { data, error } = await db.from('site_settings').select('settings').eq('id', 1).single();
  if (error) toast(explain(error), 'error');
  fill(data?.settings ?? {});
</script>
