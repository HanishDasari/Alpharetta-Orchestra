---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { photos } from '../lib/photos';

/* Duplicate of the current homepage, section for section:
     1. full-bleed hero photo (no text on it)
     2. white band — photo left, intro copy right
     3. silver band — three alternating photo/text rows
     4. white band — left-aligned Dudamel quote
   The one addition is the calendar placeholder, styled to match. */

const rows = [
  {
    title: 'About the Program',
    img: photos.program,
    flip: false,
    body:
      'The nationally recognized Alpharetta High School orchestra program was ' +
      'established in the fall of 2004 and is comprised of six orchestras and ' +
      'about 130 members. Alpharetta High School Orchestras strive for ' +
      'excellence in music education at the high school level.',
    href: '/about',
  },
  {
    title: 'The Orchestras',
    img: photos.orchestras,
    flip: true,
    body:
      'The Alpharetta High School Orchestra program is made up of six ensembles: ' +
      'the Concert, Silver, Philharmonia, Sinfonia, Symphony, and Chamber ' +
      'orchestras. The orchestras have consistently achieved Superior ratings at ' +
      'adjudications and have travelled to perform locally, statewide, and nationally.',
    href: '/orchestras',
  },
  {
    title: 'About the Director',
    img: photos.director,
    flip: false,
    body: 'Jake Hood was named Director of Orchestras at Alpharetta High School in 2022.',
    href: '/about#director',
  },
];
---

<Base title="home">
  <!-- 1. Hero photo, full bleed, no overlay text ------------------ -->
  <section class="hero">
    <img src={photos.hero} alt="" fetchpriority="high" />
  </section>

  <!-- 2. Intro: photo left, copy right ---------------------------- -->
  <section class="intro">
    <div class="wrap duo">
      <img class="intro__img" src={photos.intro} alt="" />
      <div>
        <p>
          The Alpharetta High School Orchestra, located in Alpharetta, Georgia
          has approximately 130 students participating in 6 distinct levels of
          daily string/orchestra instruction. The program focuses on improving
          string technique, musicianship, ear training, and both solo and
          ensemble playing to prepare students to be thriving, independent
          musicians. The orchestra program has students who are extremely
          enthusiastic and dedicated to their craft.
        </p>
        <p>
          The orchestra is fortunate to have incredible facilities and
          equipment, a supportive administrative team, and an amazing parent
          booster organization.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Silver band: three alternating rows ---------------------- -->
  <section class="feat">
    <div class="wrap">
      {rows.map((r) => (
        <div class:list={['duo', 'feat__row', r.flip && 'duo--flip']}>
          <img class="feat__img" src={r.img} alt="" loading="lazy" />
          <div>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
            <a href={r.href} class="btn-learn">Learn More</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Proposed addition: upcoming concerts ------------------------ -->
  <section class="add">
    <div class="wrap">
      <Placeholder
        label="Calendar goes here"
        note="The next two or three concerts, filled in automatically from the dates you enter. Nothing to update by hand."
        height="240px"
      />
    </div>
  </section>

  <!-- 4. Quote, left aligned -------------------------------------- -->
  <section class="quote">
    <div class="wrap">
      <h2>&ldquo;With an orchestra, you are building citizens, better citizens for the community.&rdquo;</h2>
      <p>&mdash; Gustavo Dudamel</p>
    </div>
  </section>
</Base>

<style>
  /* The header is fixed and overlays the top of the hero photo,
     exactly as it does on the live site. */
  .hero { height: 528px; overflow: hidden; }
  .hero img { width: 100%; height: 100%; object-fit: cover; }

  .intro { background: #fff; padding-block: 42px 104px; }
  .intro__img { width: 100%; aspect-ratio: 589 / 393; object-fit: cover; }

  .feat { background: var(--silver); color: #fff; padding-block: 85px; }
  .feat__row + .feat__row { margin-top: 121px; }
  .feat__img { width: 100%; aspect-ratio: 539 / 358; object-fit: cover; }
  .feat h3 { color: #fff; margin-bottom: 28px; }
  .feat p { margin-bottom: 40px; }

  .add { background: #fff; padding-block: 64px; }

  .quote { background: #fff; padding-block: 85px; }
  .quote h2 { max-width: 589px; margin-bottom: 32px; }
  .quote p { margin: 0; }

  @media (max-width: 900px) {
    .hero { height: 300px; }
    .intro { padding-block: 32px 56px; }
    .feat { padding-block: 56px; }
    .feat__row + .feat__row { margin-top: 64px; }
    .quote { padding-block: 56px; }
  }
</style>
