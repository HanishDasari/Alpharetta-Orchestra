---
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import { getSitePage } from '../lib/content';

/* The homepage is a page of sections like any other, edited in the
   portal under Pages > Home. */
const page = await getSitePage('home');
---

<Base title="home" description={page.description} flushHeader={page.blocks[0]?.type === 'hero'}>
  <Blocks blocks={page.blocks} />
</Base>
