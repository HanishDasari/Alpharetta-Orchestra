---
import AuthShell from '../../components/AuthShell.astro';

/* Sign in. Accounts are invite-only: there's no sign-up form, because
   every account needs a role, and roles are set by the director or the
   booster board in Supabase (see docs/portals-setup.md). */
---

<AuthShell title="Sign in">
  <h1>Sign in</h1>
  <p class="lede">For the director, booster board, students and families.</p>

  <form id="signin" novalidate>
    <div class="fld">
      <label for="email">Email</label>
      <input class="inp" id="email" name="email" type="email" autocomplete="username" required />
    </div>
    <div class="fld">
      <label for="pw">Password</label>
      <input class="inp" id="pw" name="password" type="password" autocomplete="current-password" required />
    </div>
    <p class="err" id="err" role="alert" hidden></p>
    <button class="pbtn pbtn--primary pbtn--wide" type="submit">Sign in</button>
  </form>

  <details class="forgot">
    <summary>Forgot your password?</summary>
    <form id="reset" novalidate>
      <p>We&rsquo;ll email you a link to choose a new one.</p>
      <div class="fld">
        <label for="reset-email">Email</label>
        <input class="inp" id="reset-email" type="email" autocomplete="username" required />
      </div>
      <p class="err" id="reset-msg" role="status" hidden></p>
      <button class="pbtn pbtn--ghost" type="submit">Send reset link</button>
    </form>
  </details>

  <section class="demo" aria-labelledby="demo-h">
    <h2 id="demo-h">Try it without an account</h2>
    <p>Open any portal in demo mode, with sample data. Nothing you do there reaches the real site or database.</p>
    <div class="demo__grid">
      <button type="button" data-demo-role="admin"><b>Director</b><small>Website, roster, board, forms, slides</small></button>
      <button type="button" data-demo-role="webmaster"><b>Webmaster</b><small>Edit the website</small></button>
      <button type="button" data-demo-role="student"><b>Student</b><small>Today&rsquo;s board, forms</small></button>
      <button type="button" data-demo-role="family"><b>Family</b><small>Your student, forms, fees</small></button>
      <button type="button" data-demo-role="treasurer"><b>Treasurer</b><small>Fees and payments (sample)</small></button>
    </div>
  </section>

  <p class="fine">
    No account? Accounts are set up by the program, not self-service.
    Students and families: ask <a href="/contact">Mr. Hood</a>.
  </p>
</AuthShell>

<script>
  import { supabase } from '../../lib/supabase';
  import { HOME, type Role } from '../../portal/client';
  import { startDemo } from '../../portal/demo';

  document.querySelectorAll<HTMLButtonElement>('[data-demo-role]').forEach((b) => {
    b.addEventListener('click', () => {
      const role = b.dataset.demoRole as Role;
      startDemo(role);
      location.assign(HOME[role]);
    });
  });

  const db = supabase();
  const form = document.getElementById('signin') as HTMLFormElement;
  const err = document.getElementById('err')!;

  function show(el: HTMLElement, msg: string) { el.textContent = msg; el.hidden = !msg; }

  // Only same-site paths, so a crafted ?next= can't bounce people elsewhere.
  function nextPath(): string | null {
    const n = new URLSearchParams(location.search).get('next');
    return n && n.startsWith('/portal/') && !n.startsWith('//') ? n : null;
  }

  async function goHome() {
    const { data: { user } } = await db!.auth.getUser();
    if (!user) return;
    const { data } = await db!.from('profiles').select('role').eq('id', user.id).single();
    location.replace(nextPath() ?? (data ? HOME[data.role as Role] : '/portal/admin'));
  }

  if (!db) {
    show(err, 'The portal isn’t connected to its database yet. See docs/portals-setup.md.');
    form.querySelector('button')!.disabled = true;
  } else {
    // Already signed in? Skip the form.
    db.auth.getSession().then(({ data }) => { if (data.session) goHome(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.email as HTMLInputElement).value.trim();
      const password = (form.password as HTMLInputElement).value;
      if (!email || !password) return show(err, 'Enter your email and password.');
      const btn = form.querySelector('button')!;
      btn.disabled = true; btn.textContent = 'Signing in…';
      const { error } = await db.auth.signInWithPassword({ email, password });
      if (error) {
        btn.disabled = false; btn.textContent = 'Sign in';
        return show(err, /invalid/i.test(error.message)
          ? 'That email and password don’t match. Check them, or reset your password below.'
          : error.message);
      }
      goHome();
    });

    const reset = document.getElementById('reset') as HTMLFormElement;
    const msg = document.getElementById('reset-msg')!;
    reset.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('reset-email') as HTMLInputElement).value.trim();
      if (!email) return show(msg, 'Enter the email you sign in with.');
      await db.auth.resetPasswordForEmail(email, { redirectTo: `${location.origin}/portal/reset` });
      // Same message either way, so this can't be used to find out who has an account.
      show(msg, 'If that email has an account, a reset link is on its way.');
    });
  }
</script>
