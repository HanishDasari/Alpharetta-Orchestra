---
/* Duplicates the current site's footer: gray band, three columns.
   NOTE: the live site uses dark text (#101820) on this gray, which
   fails contrast. Kept faithful for the demo — flagged in the README. */
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <h4>Alpharetta High School Orchestras</h4>
      <p>3595 Webb Bridge Road<br />Alpharetta, GA 30005</p>
    </div>

    <div>
      <p class="ftr__head">About</p>
      <p><a href="/about">The Program</a></p>
    </div>

    <div>
      <p class="ftr__head">Donate</p>
      <p><a href="/support">Support Us</a></p>
      <p><a href="/portal">Sign in</a></p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: #53565A;
    color: var(--ink);
    padding-block: 3.2rem;
    margin-top: auto;
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: 689fr 189fr 189fr;
    gap: 3.5rem;
  }
  .ftr h4 {
    font-family: var(--font-display);
    font-size: 25.2px; font-weight: 500; line-height: 34.5px;
    margin: 0 0 2rem;
  }
  .ftr__head {
    font-size: 23.7px; font-weight: 300; line-height: 42.6px;
    margin: 0 0 .75rem;
  }
  .ftr p { font-size: 16px; font-weight: 300; line-height: 28.8px; margin: 0; max-width: none; }
  .ftr a { color: var(--maroon); text-decoration: none; }
  .ftr a:hover { text-decoration: underline; }

  @media (max-width: 800px) {
    .ftr__grid { grid-template-columns: 1fr; gap: 2rem; }
    .ftr h4 { margin-bottom: 1rem; }
  }
</style>
