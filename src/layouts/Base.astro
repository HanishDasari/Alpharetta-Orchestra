---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getSettings } from '../lib/content';
import { resolveDesign, fontsHref } from '../lib/design';

interface Props {
  title: string;
  description?: string;
  /** Homepage only: let the hero photo run under the fixed header,
      the way the current site does. */
  flushHeader?: boolean;
  /** Keep internal pages (proposals, drafts) out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = 'The Alpharetta High School Orchestras — approximately 130 students in six levels of daily string instruction in Alpharetta, Georgia.',
  flushHeader = title === 'home',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'home'
  ? 'Alpharetta High School Orchestras'
  : `${title} — Alpharetta High School Orchestras`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Colours, fonts and header size chosen under Design & Appearance in
// the portal. Applied at build time, so there's no flash on load.
const design = resolveDesign(await getSettings());
const themeVars = [
  `--maroon:${design.colors.maroon}`,
  `--maroon-bright:${design.colors.maroonBright}`,
  `--ink:${design.colors.ink}`,
  `--font-display:'${design.fontDisplay}', var(--font-fallback)`,
  `--font-body:'${design.fontBody}', var(--font-fallback)`,
].join(';');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref([design.fontBody, design.fontDisplay])} rel="stylesheet" />
    <style is:inline set:html={`:root{${themeVars}}`}></style>

    <link rel="alternate" type="text/calendar" href="/events.ics" title="AHS Orchestra Events" />
  </head>

  <body data-header={design.headerSize}>
    <Header />
    <main id="main" class:list={[!flushHeader && 'main--offset']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Inner pages start below the fixed header; the homepage doesn't,
     so its hero photo sits underneath it. */
  .main--offset { padding-top: var(--header-h); }
</style>
