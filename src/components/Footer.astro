---
import { contact, social } from '../lib/links';

/* Same gray band and three columns as the current site's footer. The
   live site sets dark text (#101820) on this gray, which fails contrast
   (2.6:1); this uses white, which passes at 7.5:1. */
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <h4>Alpharetta High School Orchestras</h4>
      <p>{contact.school.street}<br />{contact.school.city}</p>
      <p class="ftr__mail"><a href={`mailto:${contact.director.email}`}>{contact.director.email}</a></p>
    </div>

    <div>
      <p class="ftr__head">About</p>
      <p><a href="/about">The Program</a></p>
      <p><a href="/news">News</a></p>
      <p><a href="/contact">Contact</a></p>
      <p><a href={social.instagram} rel="noopener">Instagram</a></p>
      <p><a href={social.youtube} rel="noopener">YouTube</a></p>
    </div>

    <div>
      <p class="ftr__head">Donate</p>
      <p><a href="/support">Support Us</a></p>
      <p><a href="/portal">Sign in</a></p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: #53565A;
    color: #fff;
    padding-block: 3.2rem;
    margin-top: auto;
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: 689fr 189fr 189fr;
    gap: 3.5rem;
  }
  .ftr h4 {
    font-family: var(--font-display);
    font-size: 25.2px; font-weight: 500; line-height: 34.5px;
    margin: 0 0 2rem;
  }
  .ftr__head {
    font-size: 23.7px; font-weight: 300; line-height: 42.6px;
    margin: 0 0 .75rem;
  }
  .ftr p { font-size: 16px; font-weight: 300; line-height: 28.8px; margin: 0; max-width: none; }
  .ftr__mail { margin-top: 1rem !important; }
  .ftr a { color: #fff; text-decoration: underline; text-decoration-color: rgb(255 255 255 / .35); text-underline-offset: .2em; }
  .ftr a:hover { text-decoration-color: #fff; }
  .ftr :focus-visible { outline-color: #fff; }

  @media (max-width: 800px) {
    .ftr__grid { grid-template-columns: 1fr; gap: 2rem; }
    .ftr h4 { margin-bottom: 1rem; }
  }
</style>
