---
import Portal from '../../layouts/Portal.astro';

const tiles = [
  { n: '3', label: 'Upcoming concerts', sub: 'Next: Oct 15' },
  { n: '6', label: 'Orchestras', sub: 'All published' },
  { n: '128', label: 'Students', sub: '2026–27 roster' },
  { n: '1', label: 'Announcements', sub: 'Last posted Aug 1' },
];

const roster = [
  { student: 'Anh Nguyen', ensemble: 'Symphony', period: '4th', year: '2028' },
  { student: 'Dev Patel', ensemble: 'Philharmonia', period: '2nd', year: '2027' },
  { student: 'Cora Brooks', ensemble: 'Chamber', period: '7th', year: '2026' },
  { student: 'Ife Okafor', ensemble: 'Concert', period: '8th', year: '2029' },
];
---

<Portal title="Dashboard" role="admin">
  <h1>Dashboard</h1>
  <p class="sub">The website, and your roster.</p>

  <div class="tiles">
    {tiles.map((t) => (
      <div class="tile">
        <span class="tile__n">{t.n}</span>
        <b>{t.label}</b>
        <small>{t.sub}</small>
      </div>
    ))}
  </div>

  <!-- Add a concert ------------------------------------------------->
  <section class="card" id="events">
    <h2>Add a concert</h2>
    <div class="fld">
      <label for="t">Title</label>
      <input class="inp" id="t" value="Fall Concert 2026" readonly />
    </div>
    <div class="row2">
      <div class="fld">
        <label for="d">Date</label>
        <input class="inp" id="d" value="October 15, 2026" readonly />
      </div>
      <div class="fld">
        <label for="tm">Start time</label>
        <input class="inp" id="tm" value="7:00 PM" readonly />
      </div>
    </div>
    <div class="fld">
      <label for="loc">Location</label>
      <input class="inp" id="loc" value="AHS Performing Arts Center" readonly />
    </div>
    <div class="fld">
      <label>Who&rsquo;s performing</label>
      <div class="chips">
        {['Concert','Silver','Philharmonia','Sinfonia','Symphony','Chamber'].map((e) => (
          <span class="chip on">{e}</span>
        ))}
      </div>
    </div>
    <div class="fld">
      <label for="desc">Description</label>
      <textarea class="inp inp--area" id="desc" readonly>Opening with visiting 8th graders from Webb Bridge and Hopewell. Free and open to the public.</textarea>
    </div>
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
      <button class="pbtn pbtn--primary" type="button">Publish</button>
      <button class="pbtn pbtn--ghost" type="button">Save as draft</button>
      <small style="margin-left:auto;color:var(--ink-soft)">Live in about 30 seconds</small>
    </div>
  </section>

  <!-- Roster — no money on this page -------------------------------->
  <section class="card" id="roster">
    <h2>Roster</h2>
    <table class="tbl">
      <thead>
        <tr><th>Student</th><th>Ensemble</th><th>Period</th><th>Class of</th></tr>
      </thead>
      <tbody>
        {roster.map((r) => (
          <tr>
            <td>{r.student}</td><td>{r.ensemble}</td><td>{r.period}</td><td>{r.year}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Explicitly out of scope for this role ------------------------- -->
  <section class="card">
    <h2>What this role can&rsquo;t reach</h2>
    <div class="locked">
      <span aria-hidden="true" style="font-size:1.1rem;line-height:1">🔒</span>
      <span>
        <b style="display:block;color:var(--ink);margin-bottom:.25rem">
          Fees and payment records belong to the treasurer
        </b>
        Who owes what, who has paid, and payment history are not visible from
        this login. The database won&rsquo;t return those rows for the director
        role, so they can&rsquo;t be reached by navigating to them either.
      </span>
    </div>
  </section>
</Portal>
