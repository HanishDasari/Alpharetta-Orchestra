---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { photos } from '../lib/photos';

/* DEMO BUILD.
   Sections that exist on the current site are real. Sections we're
   proposing to add are marked with <Placeholder /> so the director can
   see where they'd sit without us inventing content for them.
   The working calendar lives on /calendar — this page just points at it. */
const cards = [
  {
    title: 'About the Program',
    img: photos.program,
    body:
      'The nationally recognized Alpharetta High School orchestra program was ' +
      'established in the fall of 2004 and is comprised of six orchestras and ' +
      'about 130 members. Alpharetta High School Orchestras strive for ' +
      'excellence in music education at the high school level.',
    href: '/about',
  },
  {
    title: 'The Orchestras',
    img: photos.orchestras,
    body:
      'The program is made up of six ensembles: the Concert, Silver, ' +
      'Philharmonia, Sinfonia, Symphony, and Chamber orchestras. The ' +
      'orchestras have consistently achieved Superior ratings at adjudications ' +
      'and have travelled to perform locally, statewide, and nationally.',
    href: '/orchestras',
  },
  {
    title: 'About the Director',
    img: photos.director,
    body:
      'Jake Hood was named Director of Orchestras at Alpharetta High School in ' +
      '2022, and was named the school’s 2026–2027 Teacher of the Year.',
    href: '/about#director',
  },
];
---

<Base title="home">
  <!-- Hero — full-bleed photo with the program intro over it -------->
  <section class="hero">
    <img class="hero__img" src={photos.hero} alt="" fetchpriority="high" />
    <div class="hero__scrim"></div>
    <div class="wrap hero__inner">
      <p class="hero__eyebrow">Alpharetta, Georgia</p>
      <h1>Alpharetta High School Orchestras</h1>
      <p class="hero__lede">
        Approximately 130 students in six distinct levels of daily
        string&nbsp;/&nbsp;orchestra instruction &mdash; building technique,
        musicianship, ear training, and both solo and ensemble playing, to
        prepare students to be thriving, independent musicians.
      </p>
      <div class="hero__actions">
        <a href="/orchestras" class="btn btn--primary">Meet the orchestras</a>
        <a href="/calendar" class="btn btn--onphoto">Upcoming concerts</a>
      </div>
    </div>
  </section>

  <!-- Proposed: upcoming concerts ---------------------------------->
  <section class="section">
    <div class="wrap">
      <Placeholder
        label="Calendar goes here"
        note="The next two or three concerts, filled in automatically from the dates you enter. Nothing to update by hand."
        height="240px"
      />
    </div>
  </section>

  <!-- Three cards — same three as the current site ------------------>
  <section class="section section--alt">
    <div class="wrap">
      <div class="cards">
        {cards.map((c) => (
          <article class="c">
            <a href={c.href} class="c__media">
              <img src={c.img} alt="" loading="lazy" />
            </a>
            <div class="c__body">
              <h3 class="c__title"><a href={c.href}>{c.title}</a></h3>
              <p class="c__text">{c.body}</p>
              <span class="c__more">Learn more &rarr;</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Proposed: announcements --------------------------------------->
  <section class="section">
    <div class="wrap">
      <Placeholder
        label="Announcements go here"
        note="Short posts for reminders — call times, uniform notes, trip deadlines. You post, it shows up."
        height="180px"
      />
    </div>
  </section>

  <!-- Proposed: photos ---------------------------------------------->
  <section class="section section--alt">
    <div class="wrap">
      <Placeholder
        label="Concert photos go here"
        note="A strip from the most recent concert, linking to the full set. Photos attach to the concert they came from."
        height="220px"
      />
    </div>
  </section>

  <!-- Quote --------------------------------------------------------->
  <section class="section quote">
    <div class="wrap">
      <blockquote>
        <p>&ldquo;With an orchestra, you are building citizens, better citizens for the community.&rdquo;</p>
        <cite>Gustavo Dudamel</cite>
      </blockquote>
    </div>
  </section>
</Base>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(460px, 72vh, 720px);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__img {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover; object-position: center 30%;
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to top, rgba(16,24,32,.92) 0%, rgba(16,24,32,.72) 38%, rgba(16,24,32,.25) 70%, rgba(16,24,32,.35) 100%);
  }
  .hero__inner { padding-block: clamp(2.5rem, 6vw, 4.5rem); color: #fff; max-width: 780px; }
  .hero__eyebrow {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: #E3C9C8; margin: 0 0 0.9rem;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
    line-height: 1.08; letter-spacing: -0.03em;
    margin: 0 0 1.1rem; color: #fff;
  }
  .hero__lede {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.6; font-weight: 400;
    color: rgba(255,255,255,.88); max-width: 58ch; margin: 0;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }

  .btn--onphoto {
    border-color: rgba(255,255,255,.5); color: #fff; background: transparent;
  }
  .btn--onphoto:hover { border-color: #fff; background: rgba(255,255,255,.12); color: #fff; }

  /* Three cards ---------------------------------------------------- */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
  .c { display: flex; flex-direction: column; }
  .c__media {
    display: block; overflow: hidden; border-radius: var(--radius);
    aspect-ratio: 4 / 3; background: var(--rule);
  }
  .c__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .c:hover .c__media img { transform: scale(1.04); }

  .c__body { padding-top: 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .c__title { font-size: var(--step-1); margin-bottom: 0.6rem; }
  .c__title a { color: var(--ink); text-decoration: none; }
  .c__title a:hover { color: var(--maroon); }
  .c__text { font-size: 0.925rem; color: var(--ink-soft); flex: 1; margin-bottom: 1rem; }
  .c__more { font-size: 0.85rem; font-weight: 600; color: var(--maroon); }

  /* Quote ---------------------------------------------------------- */
  .quote { text-align: center; }
  .quote blockquote { margin: 0 auto; max-width: 46ch; }
  .quote p {
    font-size: var(--step-2); font-weight: 300; line-height: 1.4;
    letter-spacing: -0.02em; margin-bottom: 1.25rem; max-width: none;
  }
  .quote cite {
    font-style: normal; font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .c:hover .c__media img { transform: none; }
  }
</style>
